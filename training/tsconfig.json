{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["*.ts", "lib/**/*.ts", "scripts/**/*.ts", "workflows/**/*.ts", "tests/**/*.ts"]
}
