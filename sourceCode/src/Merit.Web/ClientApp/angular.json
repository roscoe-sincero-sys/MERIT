{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": { "analytics": false },
  "projects": {
    "merit": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "merit",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": { "base": "../wwwroot/app", "browser": "" },
            "baseHref": "/app/",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "styles": [],
            "outputHashing": "all",
            "deleteOutputPath": true
          },
          "configurations": {
            "production": {
              "optimization": true,
              "budgets": [
                { "type": "initial", "maximumWarning": "350kB", "maximumError": "500kB" },
                { "type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB" },
                { "type": "bundle", "name": "queues-page", "maximumWarning": "60kB", "maximumError": "120kB" },
                { "type": "bundle", "name": "held-page", "maximumWarning": "60kB", "maximumError": "120kB" },
                { "type": "bundle", "name": "results-page", "maximumWarning": "60kB", "maximumError": "120kB" },
                { "type": "bundle", "name": "timeline-page", "maximumWarning": "60kB", "maximumError": "120kB" },
                { "type": "bundle", "name": "match-review-page", "maximumWarning": "60kB", "maximumError": "120kB" },
                { "type": "bundle", "name": "case-map-page", "maximumWarning": "60kB", "maximumError": "120kB" },
                { "type": "bundle", "name": "clusters-page", "maximumWarning": "60kB", "maximumError": "120kB" },
                { "type": "bundle", "name": "reports-page", "maximumWarning": "60kB", "maximumError": "120kB" }
              ]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
