@model ExtractsModel
@{
    ViewData["Title"] = "Federal extracts";
}
<h1>Federal extracts</h1>
<p class="merit-meta">CBLS (CDC childhood blood lead surveillance) is quarterly; ABLES (NIOSH adult blood lead) is annual. Files carry a stable surrogate id, date of birth, county and the fields each layout requires &mdash; never names, street addresses, phone numbers, SSNs or medical record numbers. Each run is validated before submission.</p>
<section class="merit-section" aria-labelledby="request-heading">
    <h2 id="request-heading">Request a file</h2>
    <form class="usa-form merit-form-row" hx-post="/extracts" hx-target="#extract-runs" hx-swap="outerHTML">
        <div class="usa-form-group"><label class="usa-label" for="extractType">Extract</label>
            <select class="usa-select" id="extractType" name="extractType"><option value="CBLS">CBLS (quarterly)</option><option value="ABLES">ABLES (annual)</option></select></div>
        <div class="usa-form-group"><label class="usa-label" for="year">Year</label><input class="usa-input usa-input--small" id="year" name="year" value="@Model.Year" inputmode="numeric" /></div>
        <div class="usa-form-group" data-show-when="extractType=CBLS"><label class="usa-label" for="quarter">Quarter (CBLS)</label>
            <select class="usa-select" id="quarter" name="quarter">@for (int q = 1; q <= 4; q++) { <option value="@q" selected="@(q == Model.Quarter)">Q@(q)</option> }</select></div>
        <div class="usa-form-group"><button class="usa-button" type="submit">Request</button></div>
    </form>
</section>
<section class="merit-section" aria-labelledby="runs-heading">
    <h2 id="runs-heading">Runs</h2>
    <partial name="_Runs" model="Model" />
</section>
