@model RelationshipFormModel
<div class="merit-inline-form" id="relationship-form-body">
    <h3>Add a relationship</h3>
    @if (!ViewData.ModelState.IsValid)
    {
        <partial name="_ErrorSummary" model='new ErrorSummaryModel(["NewLastName", "NewFirstName", "NewDob", "Role", "Source", "IsPrimaryContact", "HasLegalCustody"], new Dictionary<string, string> { ["NewLastName"] = "relationship-NewLastName", ["NewFirstName"] = "relationship-NewFirstName", ["NewDob"] = "relationship-NewDob", ["Role"] = "relationship-Role", ["Source"] = "relationship-Source", ["IsPrimaryContact"] = "relationship-IsPrimaryContact", ["HasLegalCustody"] = "relationship-HasLegalCustody" }, SummaryId: "shared-relationshipform-errors")' />
    }
    <form class="usa-form" hx-post="/people/@Model.PersonId/relationships" hx-target="#section-relationships" hx-swap="outerHTML"
          hx-status:422="target:#relationship-form-body swap:outerHTML">
        <partial name="_Combobox" model='("relationship-RelatedPersonId", "RelatedPersonId", "Existing person", "/lookup/people", Model.RelatedPersonId?.ToString(), Model.RelatedPersonLabel, (string?)"Type a last name to pick someone already in the registry, or enter a new contact-only person below.")' />
        <fieldset class="usa-fieldset">
            <legend class="usa-legend">Or a new contact-only person</legend>
            <div class="merit-form-row">
                <div class="usa-form-group"><label class="usa-label" for="relationship-NewLastName">Last name</label><input class="usa-input" id="relationship-NewLastName" name="NewLastName" value="@Model.NewLastName" /></div>
                <div class="usa-form-group"><label class="usa-label" for="relationship-NewFirstName">First name</label><input class="usa-input" id="relationship-NewFirstName" name="NewFirstName" value="@Model.NewFirstName" /></div>
                <div class="usa-form-group"><label class="usa-label" for="relationship-NewDob">Date of birth</label><input class="usa-input" id="relationship-NewDob" name="NewDob" type="date" value="@Options.Iso(Model.NewDob)" /></div>
            </div>
        </fieldset>
        <div class="merit-form-row">
            <div class="usa-form-group">
                <label class="usa-label" for="relationship-Role">The other person is this person's</label>
                <select class="usa-select" id="relationship-Role" name="Role" required>@foreach (var o in Model.Roles) { <option value="@o.Value" selected="@o.Selected">@o.Label</option> }</select>
            </div>
            <div class="usa-form-group">
                <label class="usa-label" for="relationship-Source">Source</label>
                <select class="usa-select" id="relationship-Source" name="Source">
                    <option value="interview">Interview</option><option value="caseManager">Case manager</option><option value="labReport">Lab report</option><option value="otherAgency">Other agency</option>
                </select>
            </div>
        </div>
        <div class="usa-checkbox"><input class="usa-checkbox__input" id="relationship-IsPrimaryContact" type="checkbox" name="IsPrimaryContact" value="true" checked="@(Model.IsPrimaryContact)" /><label class="usa-checkbox__label" for="relationship-IsPrimaryContact">Primary contact</label></div>
        <div class="usa-checkbox"><input class="usa-checkbox__input" id="relationship-HasLegalCustody" type="checkbox" name="HasLegalCustody" value="true" checked="@(Model.HasLegalCustody)" /><label class="usa-checkbox__label" for="relationship-HasLegalCustody">Has legal custody</label></div>
        <button class="usa-button" type="submit">Add relationship</button>
        <button class="usa-button usa-button--unstyled" type="button" data-clear-target="#relationships-form">Cancel</button>
    </form>
</div>
