@model ResultsSectionModel
<section class="merit-section" id="section-results" aria-labelledby="results-heading">
    <div class="merit-section__head">
        <h2 id="results-heading">Results</h2>
        <div class="merit-section__actions">
        @if (Model.CanEnter) { <a class="usa-button usa-button--outline usa-button--small" href="/people/@Model.PersonId/results/new">Enter a result</a> }
        </div>
    </div>
    @if (Model.AnalyteOptions.Count > 2)
    {
        <form class="usa-form" hx-get="/people/@Model.PersonId/results" hx-target="#section-results" hx-swap="outerHTML" hx-trigger="change">
            <label class="usa-label" for="results-analyte">Substance tested (analyte)</label>
            <select class="usa-select" id="results-analyte" name="analyteId">
                @foreach (var o in Model.AnalyteOptions) { <option value="@o.Value" selected="@o.Selected">@o.Label</option> }
            </select>
        </form>
    }

    @foreach (var chart in Model.Charts)
    {
        <partial name="_TrendChart" model="chart" />
    }

    @if (Model.Rows.Count > 0)
    {
        <p>Laboratory status (for example, Final) describes the report, not whether a follow-up case is resolved. Withdrawn, duplicate and superseded rows are history and do not count toward future classification. Open a result date to see its original report, recorded rule decision and correction links.</p>
        @foreach (var group in Model.Rows.Where(r => r.ResultRowStatus == "valid" && r.ResultStatus is "final" or "corrected")
            .GroupBy(r => new { r.AnalyteCode, r.Specimen, r.SampleType, r.Speciation, r.TestMethod, r.UnitCanonical }))
        {
            var latest = group.OrderByDescending(r => r.CollectedDate).ThenByDescending(r => r.ReceivedUtc).First();
            var earlier = group.Where(r => r.CollectedDate < latest.CollectedDate).OrderByDescending(r => r.CollectedDate).FirstOrDefault();
            <p><strong>Latest @Options.Humanize(latest.AnalyteCode) @Options.Humanize(latest.Specimen) @Options.Humanize(latest.SampleType) @latest.Speciation (@Options.Humanize(latest.TestMethod)):</strong>
                @Options.Value(latest.Operator, latest.ValueCanonical, latest.UnitCanonical) on @Options.Date(latest.CollectedDate).
                @if (earlier is not null && latest.Operator == "=" && earlier.Operator == "=" && latest.ValueCanonical is not null && earlier.ValueCanonical is not null)
                {
                    <span>@(latest.ValueCanonical > earlier.ValueCanonical ? "Higher" : latest.ValueCanonical < earlier.ValueCanonical ? "Lower" : "Unchanged") compared with @Options.Date(earlier.CollectedDate).</span>
                }
                else { <span>No simple trend comparison is available for this sample type and reporting limit.</span> }
                <span>A falling value alone does not close a case.</span>
            </p>
        }
    }

    @if (Model.Rows.Count == 0)
    {
        <p class="merit-empty">No results recorded.</p>
    }
    else
    {
        <div id="section-results-table" class="merit-table-wrap merit-phone-table-wrap" tabindex="0" role="region" aria-label="Table; scroll sideways for more columns">
            <table data-phone-cards role="table" class="usa-table usa-table--borderless usa-table--compact">
                <thead><tr><th scope="col">Sample collection date</th><th scope="col">Substance tested</th><th scope="col">Result</th><th scope="col">Sample</th><th scope="col">Method</th><th scope="col">Population</th><th scope="col">Laboratory result status</th><th scope="col">Lab</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td><a class="usa-link" href="/results/@r.LabResultId">@Options.Date(r.CollectedDate)</a></td>
                            <td>@Options.Humanize(r.AnalyteCode) <span class="merit-meta">@Options.Humanize(r.Specimen)</span></td>
                            <td><strong>@Options.Value(r.Operator, r.ValueCanonical, r.UnitCanonical)</strong>
                                @if (r.UnitReported != r.UnitCanonical) { <div class="merit-meta">reported @r.ValueText @r.UnitReported</div> }
                                @if (r.IsIndeterminate) { <span class="merit-badge merit-badge--suspect">Indeterminate</span> }</td>
                            <td>@Options.Humanize(r.SampleType)</td>
                            <td>@Options.Humanize(r.TestMethod)</td>
                            <td>@Options.Population(r.Population)</td>
                            <td>@Options.Humanize(r.ResultStatus)@if (r.ResultRowStatus != "valid") { <span class="merit-badge">@Options.Humanize(r.ResultRowStatus)</span> }</td>
                            <td>@r.LabName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
