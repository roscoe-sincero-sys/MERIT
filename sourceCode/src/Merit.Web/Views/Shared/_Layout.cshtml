@inject ICurrentSession CurrentSession
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Authentication
@{
    string path = Context.Request.Path.Value ?? "/";
    bool signedIn = CurrentSession.IsAuthenticated;
    bool minimalHeader = ViewData["MinimalHeader"] is true;
    var deployment = DeploymentIndicator.From(Configuration); @* #224: configured environment and data mode only *@
    string profileHref = "/account/profiles?returnUrl=" + Uri.EscapeDataString($"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}");
    long? sessionExpires = (await Context.AuthenticateAsync(AuthSchemes.Session)).Properties?.ExpiresUtc?.ToUnixTimeMilliseconds();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @if (ViewData["ScreenVisitId"] is Guid visitId)
    {
        <meta name="merit-screen-visit" content="@visitId" data-screen-code="@ViewData["ScreenCode"]" />
    }
    @* Angular owns history inside its host; htmx must not replace its running document during Back/Forward. *@
    <meta name="htmx-config" content='{"extensions":"hx-csp","defaultTimeout":60000,"history":@(ViewData["AngularHost"] is true ? "false" : "\"reload\"")}' />
    <title>@(ViewData["Title"] is string t ? t + " - " : string.Empty)MERIT</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/uswds-3.14.0/css/uswds.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/merit.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body data-session-minutes="@(signedIn ? Configuration.GetValue("Session:IdleTimeoutMinutes", 20) : 0)" data-session-user="@CurrentSession.UserName" data-session-expires="@sessionExpires">
    <a class="merit-skip" href="#main-content">Skip to main content</a>
    @if (deployment.Banner is string environmentBanner)
    {
        <div class="merit-environment" role="note" aria-label="Environment" data-environment="@deployment.Environment!.ToLowerInvariant()">@environmentBanner</div>
    }
    @* One header for every installation: the grouped navigation from #137, no longer behind a setting (issue #184). *@
    <header class="merit-header" role="banner">
        <div class="merit-header__inner">
            <a class="merit-brand" href="/">MERIT<small>Metals Exposure Registry and Investigation Tracking</small></a>
            @if (signedIn && minimalHeader)
            {
                <div class="merit-header__user merit-header__user--minimal">
                    <span>@CurrentSession.DisplayName</span>
                    <form method="post" action="/account/signout">
                        @Html.AntiForgeryToken()
                        <button class="usa-button usa-button--unstyled" type="submit">Sign out</button>
                    </form>
                </div>
            }
            else if (signedIn)
            {
                @* On a phone the menu and the user block fold behind this button; merit.js shows it (issue #47). *@
                <button class="usa-button usa-button--outline usa-button--inverse merit-menu-button" type="button" aria-expanded="false" aria-controls="merit-nav merit-user">Menu</button>
                <nav id="merit-nav" class="merit-header__nav" aria-label="Primary">
                    @await Html.PartialAsync("_PrimaryNavigation")
                </nav>
                @* People search has its own, larger box; one search per page (issue #147). *@
                @if (CurrentSession.Has(Permissions.PersonView) && !path.Equals("/search", StringComparison.OrdinalIgnoreCase))
                {
                    <form class="merit-header__search" role="search" method="get" action="/search">
                        <label class="usa-sr-only" for="header-search">Search people, cases and accession numbers</label>
                        <input class="usa-input" id="header-search" name="q" type="search" value="@(path == "/search" ? Context.Request.Query["q"].ToString() : "")" placeholder="Name, DOB, case or accession" />
                        <button class="usa-button usa-button--accent-cool" type="submit">Search</button>
                    </form>
                }
                @if (CurrentSession.Has(Permissions.PersonView) && path.Equals("/search", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="merit-header__search merit-header__search--shortcut"><a href="#search-q" data-focus-target="search-q">Search people on this page</a></div>
                }
                <div id="merit-user" class="merit-header__user">
                    <span class="merit-header__who">@CurrentSession.DisplayName<br /><small>@CurrentSession.ActingTenantName</small></span>
                    @* A control, not a caption: profiles and jurisdictions are switched here (issue #152). *@
                    <a class="merit-header__profile merit-profile-switch" href="@profileHref">
                        <span class="merit-profile-switch__label">Profile</span>
                        <span class="merit-profile-switch__name">@(CurrentSession.ProfileName ?? "Master profile")</span>
                        <span class="merit-profile-switch__action" aria-hidden="true">Switch &#x25BE;</span><span class="usa-sr-only">: switch profile or jurisdiction</span>
                    </a>
                    <div class="merit-header__links">
                        @* The guides open beside the work, never over it (issue #148). *@
                        <a class="merit-header__help" href="/help" target="_blank" rel="noopener">User guide<span class="usa-sr-only"> (opens in a new tab)</span></a>
                        <a class="merit-header__help" href="/account/security">Sign-in methods</a>
                        <form method="post" action="/account/signout">
                            @Html.AntiForgeryToken()
                            <button class="usa-button usa-button--unstyled" type="submit">Sign out</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </header>

    @if (signedIn && CurrentSession.ViewAsDisplayName is string viewingAs)
    {
        <section class="usa-site-alert usa-site-alert--info merit-viewas" aria-label="Viewing as another user">
            <div class="usa-alert"><div class="usa-alert__body">
                <p class="usa-alert__text">You are viewing MERIT as <strong>@viewingAs</strong>, limited to what you manage. Everything you do is recorded under your own name.</p>
                <form method="post" action="/account/view-as/end">@Html.AntiForgeryToken()<button class="usa-button usa-button--small" type="submit">Return to my profile</button></form>
            </div></div>
        </section>
    }

    <main class="merit-main" id="main-content" tabindex="-1">
        <div id="alert-region" role="region" aria-label="Alerts"></div>
        @RenderBody()
    </main>

    <div id="live-region" class="usa-sr-only" aria-live="polite" aria-atomic="true"></div>

    <dialog id="dialog" class="merit-dialog" aria-label="Details">
        <button type="button" class="usa-button usa-button--unstyled merit-dialog__close" data-close-dialog aria-label="Close dialog">Close</button>
        <div id="dialog-alert-region" role="region" aria-label="Dialog alerts"></div>
        <div id="dialog-body" class="merit-dialog__content"></div>
    </dialog>

    <footer class="merit-footer">@deployment.Footer &middot; Every view, change and export of a person, result or case is audited.</footer>

    <dialog id="confirmation-dialog" class="merit-dialog" aria-labelledby="confirmation-heading" aria-describedby="confirmation-message">
        <h2 id="confirmation-heading">Confirm action</h2>
        <p id="confirmation-message"></p>
        <div class="merit-section__actions">
            <button type="button" class="usa-button usa-button--outline" data-confirm-cancel autofocus>Cancel</button>
            <button type="button" class="usa-button usa-button--secondary" data-confirm-accept>Continue</button>
        </div>
    </dialog>
    <dialog id="unsaved-work-dialog" class="merit-dialog" aria-labelledby="unsaved-work-heading" aria-describedby="unsaved-work-description">
        <h2 id="unsaved-work-heading">Leave without saving?</h2>
        <p id="unsaved-work-description">This page has unsaved changes. Leaving will discard them. Choose Stay to review and save your work.</p>
        <div class="merit-section__actions">
            <button type="button" class="usa-button" data-unsaved-stay autofocus>Stay</button>
            <button type="button" class="usa-button usa-button--outline" data-unsaved-leave>Leave without saving</button>
        </div>
    </dialog>

    <script src="~/lib/htmx-4.0.0/htmx.min.js" asp-append-version="true" merit-nonce></script>
    <script src="~/lib/htmx-4.0.0/hx-csp.min.js" asp-append-version="true" merit-nonce></script>
    <script src="~/js/merit.js" asp-append-version="true" merit-nonce></script>
    <script src="~/js/mobile-workflows.js" asp-append-version="true" merit-nonce></script>
    <script src="~/js/unsaved-work.js" asp-append-version="true" merit-nonce></script>
    @if (signedIn && Configuration.GetValue("ScreenVisit:Enabled", true))
    {
        <script src="~/js/screen-usage.js" asp-append-version="true" merit-nonce></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
