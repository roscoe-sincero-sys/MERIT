@model RelationshipsModel
<section class="merit-section" id="section-relationships" aria-labelledby="relationships-heading">
    <div class="merit-section__head">
        <h2 id="relationships-heading">Relationships</h2>
        <div class="merit-section__actions">
        @if (Model.CanEdit)
        {
            <button class="usa-button usa-button--outline usa-button--small" type="button"
                    hx-get="/people/@Model.PersonId/relationships/add" hx-target="#relationships-form" hx-swap="innerHTML">Add relationship</button>
        }
        </div>
    </div>
    <div id="relationships-form"></div>
    @if (Model.Rows.Count == 0)
    {
        <p class="merit-empty">@Model.EmptyText</p>
    }
    else
    {
        <div class="merit-table-wrap merit-phone-table-wrap" tabindex="0" role="region" aria-label="Table; scroll sideways for more columns">
            <table data-phone-cards role="table" class="usa-table usa-table--borderless">
                <thead><tr><th scope="col">Person</th><th scope="col">Is</th><th scope="col">Contact</th><th scope="col">Dates</th><th scope="col">Source</th><th scope="col"><span class="usa-sr-only">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td><a class="usa-link" href="/people/@r.OtherPersonId">@r.OtherLastName, @r.OtherFirstName</a>
                                @if (r.OtherDob is not null) { <span class="merit-meta">b. @Options.Date(r.OtherDob)</span> }
                                @if (r.OtherIsContactOnly) { <span class="merit-badge">Contact only</span> }</td>
                            <td>@r.RoleLabel @if (r.HasLegalCustody) { <span class="merit-badge">Legal custody</span> }</td>
                            <td>@if (r.IsPrimaryContact) { <span class="merit-star" aria-label="Primary contact">&#9733;</span> <span>Primary contact</span> }</td>
                            <td>@Options.Date(r.StartDate)@(r.EndDate is null ? "" : " to " + Options.Date(r.EndDate))</td>
                            <td>@Options.Humanize(r.Source)@if (r.VerifiedDate is null) { <span class="merit-meta"> (unverified)</span> }</td>
                            <td>
                                @if (Model.CanEdit && !r.IsInverse && r.EndDate is null)
                                {
                                    <p><a href="/contact-corrections?personId=@Model.PersonId&amp;caregiverId=@r.OtherPersonId">Request contact correction</a></p>
                                    <details><summary>Verify or update caregiver</summary>
                                    <form method="post" action="/people/@Model.PersonId/relationships/@r.PersonRelationshipId/verify" hx-post="/people/@Model.PersonId/relationships/@r.PersonRelationshipId/verify" hx-target="#section-relationships" hx-swap="outerHTML">
                                    @Html.AntiForgeryToken()<input type="hidden" name="rowVersion" value="@Options.Hex(r.RowVersion)" />
                                    <label class="usa-label" for="role-@r.PersonRelationshipId">Verified relationship</label><select class="usa-select" id="role-@r.PersonRelationshipId" name="role">@foreach(var role in new[] {"caregiver","parent","legalGuardian","fosterParent"}) { <option value="@role" selected="@(r.Role==role)">@Options.Humanize(role)</option> }</select>
                                    <div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" id="primary-@r.PersonRelationshipId" name="primary" value="true" checked="@r.IsPrimaryContact" /><label class="usa-checkbox__label" for="primary-@r.PersonRelationshipId">Primary contact</label></div>
                                    <div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" id="custody-@r.PersonRelationshipId" name="legalCustody" value="true" checked="@r.HasLegalCustody" /><label class="usa-checkbox__label" for="custody-@r.PersonRelationshipId">Legal custody has been verified</label></div>
                                    <div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" id="confirmed-@r.PersonRelationshipId" name="confirmed" value="true" required /><label class="usa-checkbox__label" for="confirmed-@r.PersonRelationshipId">I verified identity, relationship and contact information.</label></div>
                                    <button class="usa-button" type="submit">Save verified relationship</button></form></details>
                                    <button class="usa-button usa-button--unstyled" type="button" hx-post="/people/@Model.PersonId/relationships/@r.PersonRelationshipId/end"
                                            hx-target="#section-relationships" hx-swap="outerHTML" data-confirm="End this relationship today?">End</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
