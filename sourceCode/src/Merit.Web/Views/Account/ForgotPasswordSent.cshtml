@model ForgotPasswordModel
@{
    ViewData["Title"] = "Check your email";
}
@* The same page whatever the user name: it never says whether an account exists (#190). *@
<div class="merit-signin merit-signin--single">
    <section class="merit-signin__card" aria-labelledby="forgot-sent-heading">
        <h1 id="forgot-sent-heading">Check your email</h1>
        <div class="usa-alert usa-alert--success usa-alert--slim" role="status"><div class="usa-alert__body">
            <p class="usa-alert__text">If MERIT has an account with that user name and an email address, we've sent it a link to reset the password. The link works once, for @Model.LinkMinutes minutes.</p>
        </div></div>
        <p>Email can take a minute or two to arrive. Check your junk or spam folder too. Only the newest link works.</p>
        <p>No email? You may have mistyped the user name, or the account may have no email address. Contact your MERIT administrator.</p>
        <p><a class="usa-link" href="/account/signin">Back to sign in</a></p>
    </section>
</div>
