@model EmailCodeModel
@{
    ViewData["Title"] = Model.ForEnrollment ? "Confirm your email address" : "Enter the code from your email";
}
@* One page for both uses of an emailed code: the second step of sign-in, and proving the address before email codes are
   turned on. Sending is a plain form post bounded by the server's SMTP timeouts; merit.js shows progress and recovers
   if the page waits too long (data-merit-busy). *@
<div class="merit-signin merit-signin--single">
    <section class="merit-signin__card" aria-labelledby="email-code-heading">
        <h1 id="email-code-heading">@ViewData["Title"]</h1>
        @if (Model.DeliveryFailed)
        {
            <div class="usa-alert usa-alert--error usa-alert--slim" role="alert" data-email-delivery="failed"><div class="usa-alert__body">
                <p class="usa-alert__text">@Model.Message</p>
                <p class="usa-alert__text">Support reference: <strong data-support-reference>@Model.SupportReference</strong></p>
            </div></div>
        }
        else if (Model.JustSent)
        {
            <div class="usa-alert usa-alert--success usa-alert--slim" role="status" data-email-delivery="sent"><div class="usa-alert__body">
                <p class="usa-alert__text">We sent a six-digit code to <strong>@Model.MaskedEmail</strong>. It expires in @Model.LifetimeMinutes minutes.</p>
            </div></div>
        }
        @if (Model.Notice is not null)
        {
            <div class="usa-alert usa-alert--info usa-alert--slim" role="status"><div class="usa-alert__body"><p class="usa-alert__text">@Model.Notice</p></div></div>
        }
        <p>Email can take a minute or two to arrive. Check your junk or spam folder too. Only the newest code works, and each code works once.</p>
        <partial name="_ErrorSummary" model='new ErrorSummaryModel(["Code"], SummaryId: "email-code-errors")' />
        <form class="usa-form" method="post" action="@Model.VerifyAction" data-merit-busy="Checking your code…">
            @Html.AntiForgeryToken()
            <div class="usa-form-group">
                <label class="usa-label" for="Code">Six-digit code from the email</label>
                <div class="usa-hint" id="email-code-hint">Sent to @(Model.MaskedEmail ?? "your email address"). Spaces are fine.</div>
                <input class="usa-input usa-input--medium" id="Code" name="Code" type="text" autocomplete="one-time-code" inputmode="numeric"
                       maxlength="11" spellcheck="false" aria-describedby="email-code-hint" autofocus="@(!Model.DeliveryFailed)" required />
            </div>
            <button class="usa-button merit-signin__submit" type="submit">@(Model.ForEnrollment ? "Confirm and turn on email codes" : "Verify and sign in")</button>
        </form>

        <form class="merit-resend" method="post" action="@Model.ResendAction" data-merit-busy="Sending a new code…" data-resend-in="@Model.ResendInSeconds">
            @Html.AntiForgeryToken()
            <button class="usa-button usa-button--outline" type="submit" data-resend-button>@(Model.DeliveryFailed ? "Try sending again" : "Send a new code")</button>
            <p class="usa-hint" data-resend-status>@(Model.ResendInSeconds > 0 ? $"You can ask for a new code in {Model.ResendInSeconds} seconds." : "")</p>
        </form>

        <div class="merit-signin__mfa">
            @if (Model.ForEnrollment)
            {
                <p><a class="usa-link" href="/account/security">Cancel and keep using only your authenticator app</a></p>
            }
            else
            {
                <p><a class="usa-link" href="/account/mfa">Use your authenticator app instead</a></p>
                <p><a class="usa-link" href="/account/mfa?useRecoveryCode=true">Use a recovery code</a></p>
            }
        </div>
    </section>
</div>

@if (!Model.ForEnrollment)
{
    <form method="post" action="/account/restart-signin">
        @Html.AntiForgeryToken()
        <button class="usa-button usa-button--unstyled" type="submit">Sign in as a different user</button>
    </form>
}
