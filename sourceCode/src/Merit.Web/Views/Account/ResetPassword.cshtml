@model ResetPasswordModel
@using Merit.Application.Services
@{
    ViewData["Title"] = Model.Done ? "Password reset" : "Choose a new password";
}
<div class="merit-signin merit-signin--single">
    <section class="merit-signin__card" aria-labelledby="reset-heading">
        @if (Model.Done)
        {
            <h1 id="reset-heading">Your password has been reset</h1>
            <div class="usa-alert usa-alert--success usa-alert--slim" role="status"><div class="usa-alert__body">
                <p class="usa-alert__text">Sign in with your new password. Any other MERIT sessions on your account were signed out.</p>
            </div></div>
            <p><a class="usa-button merit-signin__submit" href="/account/signin">Sign in</a></p>
        }
        else if (Model.Closed)
        {
            <h1 id="reset-heading">This link no longer works</h1>
            <div class="usa-alert usa-alert--error usa-alert--slim" role="alert"><div class="usa-alert__body">
                <p class="usa-alert__text">The code was entered wrong too many times, so this link was closed. Ask for a new link, or contact your MERIT administrator.</p>
            </div></div>
            <p><a class="usa-link" href="/account/forgot">Ask for a new link</a></p>
        }
        else if (Model.Status == PasswordResetLinkStatus.Valid)
        {
            <h1 id="reset-heading">Choose a new password</h1>
            <p>For the MERIT account <strong>@Model.UserName</strong>. To make sure it's you, also enter a code from your authenticator app or one of your recovery codes.</p>
            <partial name="_ErrorSummary" model='new ErrorSummaryModel(["Code", "NewPassword", "ConfirmPassword"], SummaryId: "reset-errors")' />
            <form class="usa-form" method="post" action="/account/reset">
                @Html.AntiForgeryToken()
                <div class="usa-form-group">
                    <label class="usa-label" for="Code">Code from your authenticator app, or a recovery code</label>
                    <div class="usa-hint" id="reset-code-hint">Six digits from the app, or a ten-character recovery code (a recovery code is then used up).</div>
                    <input class="usa-input usa-input--medium" id="Code" name="Code" type="text" autocomplete="one-time-code" spellcheck="false" maxlength="20" aria-describedby="reset-code-hint" required autofocus />
                </div>
                <div class="usa-form-group">
                    <label class="usa-label" for="NewPassword">New password</label>
                    <div class="usa-hint" id="reset-password-hint"><partial name="_PasswordRules" model="Model.PasswordMinLength" /></div>
                    <input class="usa-input" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" aria-describedby="reset-password-hint" required />
                </div>
                <div class="usa-form-group">
                    <label class="usa-label" for="ConfirmPassword">New password again</label>
                    <input class="usa-input" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required />
                </div>
                <button class="usa-button merit-signin__submit" type="submit">Reset password</button>
            </form>
            @if (Model.RemainingAttempts is > 0 and < 5)
            {
                <p class="merit-signin__mfa">@Model.RemainingAttempts wrong code@(Model.RemainingAttempts == 1 ? "" : "s") left before this link closes.</p>
            }
        }
        else
        {
            <h1 id="reset-heading">This link can't be used</h1>
            <div class="usa-alert usa-alert--warning usa-alert--slim" role="alert"><div class="usa-alert__body">
                <p class="usa-alert__text">@(Model.Status switch
                {
                    PasswordResetLinkStatus.Expired => "This link has expired. Links work for a short time; ask for a new one.",
                    PasswordResetLinkStatus.Used => "This link was already used. If you didn't reset your password, contact your MERIT administrator.",
                    PasswordResetLinkStatus.Superseded => "A newer link was sent, or this one was closed. Use the newest email, or ask for a new link.",
                    PasswordResetLinkStatus.NoSecondFactor => "This account hasn't set up an authenticator app yet, so its password can't be reset by email. Contact your MERIT administrator.",
                    PasswordResetLinkStatus.AccountLocked => "The account is locked for a while after too many failed attempts. Try again later, or contact your MERIT administrator.",
                    _ => "This link isn't valid. Open the link from the newest email, or ask for a new one.",
                })</p>
            </div></div>
            <p><a class="usa-link" href="/account/forgot">Ask for a new link</a></p>
            <p><a class="usa-link" href="/account/signin">Back to sign in</a></p>
        }
    </section>
</div>
