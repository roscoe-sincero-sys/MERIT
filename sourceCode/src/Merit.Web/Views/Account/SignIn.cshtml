@model SignInModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="merit-signin">
    <section class="merit-signin__card" aria-labelledby="signin-heading">
        <h1 id="signin-heading">Sign in to MERIT</h1>
        @if (Model.Message is not null)
        {
            <div class="usa-alert usa-alert--error usa-alert--slim" role="alert"><div class="usa-alert__body"><p class="usa-alert__text">@Model.Message</p></div></div>
        }
        <partial name="_ErrorSummary" model='new ErrorSummaryModel(["ReturnUrl", "UserName", "Password"], new Dictionary<string, string> { ["ReturnUrl"] = "ReturnUrl", ["UserName"] = "UserName", ["Password"] = "Password" }, SummaryId: "account-signin-errors")' />
    <form class="usa-form" method="post" asp-action="SignIn">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="usa-form-group">
                <label class="usa-label" asp-for="UserName">User name</label>
                <input class="usa-input" asp-for="UserName" autocomplete="username" autocapitalize="off" spellcheck="false" required />
            </div>
            <div class="usa-form-group">
                <label class="usa-label" asp-for="Password">Password</label>
                <input class="usa-input" asp-for="Password" autocomplete="current-password" required />
            </div>
            <button class="usa-button merit-signin__submit" type="submit">Continue</button>
        </form>
        <p class="merit-signin__mfa">After your password you will be asked for a code from your authenticator app. Multi-factor authentication is required for every account.</p>
    </section>
    <aside class="merit-signin__about" aria-labelledby="about-heading">
        <h2 id="about-heading">One registry for metals exposure</h2>
        <ul>
            <li>Laboratory results for lead, arsenic, mercury and cadmium, matched to one record per person.</li>
            <li>Cases, follow-up tasks and home, child-care and workplace investigations.</li>
            <li>CDC CBLS and NIOSH ABLES extracts without names or addresses.</li>
        </ul>
        <p>Every view, change and export of a person, result or case is recorded.</p>
    </aside>
</div>
