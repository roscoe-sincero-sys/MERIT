@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}
<div class="merit-signin merit-signin--single">
    <section class="merit-signin__card" aria-labelledby="forgot-heading">
        <h1 id="forgot-heading">Reset your password</h1>
        @if (Model.Available)
        {
            <p>Enter your MERIT user name. If your account has an email address, we'll send it a link to choose a new password. The link works once, for @Model.LinkMinutes minutes.</p>
            <p>You will also need your authenticator app or one of your recovery codes. A password reset never skips that step.</p>
            <partial name="_ErrorSummary" model='new ErrorSummaryModel(["UserName"], SummaryId: "forgot-errors")' />
            <form class="usa-form" method="post" action="/account/forgot" data-merit-busy="Sending…">
                @Html.AntiForgeryToken()
                <div class="usa-form-group">
                    <label class="usa-label" for="UserName">User name</label>
                    <input class="usa-input" id="UserName" name="UserName" type="text" autocomplete="username" spellcheck="false" value="@Model.UserName" required autofocus />
                </div>
                <button class="usa-button merit-signin__submit" type="submit">Email me a reset link</button>
            </form>
        }
        else
        {
            <div class="usa-alert usa-alert--info usa-alert--slim" role="status"><div class="usa-alert__body">
                <p class="usa-alert__text">MERIT can't email reset links here. Contact your MERIT administrator: after confirming who you are, they can set a new password for you.</p>
            </div></div>
        }
        <p class="merit-signin__mfa">Lost your authenticator app as well? Contact your MERIT administrator to verify your identity and reset both.</p>
        <p><a class="usa-link" href="/account/signin">Back to sign in</a></p>
    </section>
</div>
