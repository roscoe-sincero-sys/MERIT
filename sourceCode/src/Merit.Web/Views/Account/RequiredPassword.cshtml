@model RequiredPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<div class="merit-signin merit-signin--single">
    <section class="merit-signin__card" aria-labelledby="required-heading">
        <h1 id="required-heading">Choose a new password</h1>
        <p>Your MERIT administrator set a password for you. Choose your own before you continue, so only you know it.</p>
        <partial name="_ErrorSummary" model='new ErrorSummaryModel(["NewPassword", "ConfirmPassword"], SummaryId: "required-errors")' />
        <form class="usa-form" method="post" action="/account/password/required">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <div class="usa-form-group">
                <label class="usa-label" for="NewPassword">New password</label>
                <div class="usa-hint" id="required-password-hint"><partial name="_PasswordRules" model="Model.PasswordMinLength" /></div>
                <input class="usa-input" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" aria-describedby="required-password-hint" required autofocus />
            </div>
            <div class="usa-form-group">
                <label class="usa-label" for="ConfirmPassword">New password again</label>
                <input class="usa-input" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required />
            </div>
            <button class="usa-button merit-signin__submit" type="submit">Save password and continue</button>
        </form>
    </section>
</div>

<form method="post" action="/account/signout">
    @Html.AntiForgeryToken()
    <button class="usa-button usa-button--unstyled" type="submit">Sign out</button>
</form>
