@model DashboardModel
@inject ICurrentSession Session
@{
    ViewData["Title"] = "Home";
    var c = Model.Data.Counts;
    bool caseWork = Session.Has(Permissions.CaseEdit) && Session.Has(Permissions.TaskView);
}
<div class="merit-page-header">
    <h1>Welcome, @Model.DisplayName</h1>
    <span class="merit-meta">@Model.TenantName</span>
</div>

<section class="merit-section" aria-labelledby="start-heading">
<h2 id="start-heading">Start your work</h2>
<p>MERIT imports patient lab results and tracks required follow-up. These actions use your current profile and working agency.</p>
<div class="merit-section__actions">
@if(caseWork) { <a class="usa-button" href="/app/queues?mine=true">Work on my assigned follow-up</a><a class="usa-button usa-button--outline" href="/app/queues?overdue=true">Review overdue work</a> }
@if(Session.Has(Permissions.IntakeUpload)) { <a class="usa-button @(caseWork ? "usa-button--outline":"")" href="/intake">Import lab results</a> }
@if(Session.Has(Permissions.PersonView)) { <a class="usa-button usa-button--outline" href="/search">@(Session.Has(Permissions.ResultEdit) ? "Find a patient / enter a paper result":"Find a patient")</a> }
@if(Session.Has(Permissions.TaskView) && !caseWork) { <a class="usa-button usa-button--outline" href="/app/queues?mine=true">Review assigned work</a> }
@if(Session.Has(Permissions.ConfigEdit)) { <a class="usa-button usa-button--outline" href="/config/thresholds">Review program configuration</a> }
@if(Session.Has(Permissions.TenantAdminister)) { <a class="usa-button usa-button--outline" href="/admin/users">Manage user access</a> }
</div>
@if(Session.Has(Permissions.ResultEdit) && Session.Has(Permissions.PersonView)) { <p>For a fax or paper report, find the patient, check their birth date, then choose <strong>Enter a result</strong>. For a file from a laboratory, use <strong>Import lab results</strong> when available in this profile.</p> }
<p><a href="/help" target="_blank" rel="noopener">Open task guides<span class="usa-sr-only"> (opens in a new tab)</span></a>. You can start routine work without reading a guide first.</p>
</section>
<ul class="merit-tiles" aria-label="Your work">
    @* Each label says what it counts, so the held tile and the Held records queue below read as different numbers (issue #158). *@
    <li><a class="merit-tile" href="/cases?assigned=me"><span class="merit-tile__count">@c.MyOpenCases</span><span class="merit-tile__label">Open cases assigned to me</span></a></li>
    <li><a class="merit-tile" href="/app/queues?mine=true"><span class="merit-tile__count">@c.MyOpenTasks</span><span class="merit-tile__label">Open tasks assigned to me</span></a></li>
    <li><a class="merit-tile @(c.OverdueTasks > 0 ? "merit-tile--urgent" : "")" href="/app/queues?overdue=true"><span class="merit-tile__count">@c.OverdueTasks</span><span class="merit-tile__label">Overdue tasks, all queues</span></a></li>
    <li><a class="merit-tile @(c.UrgentHeld > 0 ? "merit-tile--urgent" : "")" href="/app/held"><span class="merit-tile__count">@c.UrgentHeld</span><span class="merit-tile__label">Held results with an elevated value</span></a></li>
    <li><a class="merit-tile" href="/cases"><span class="merit-tile__count">@c.OpenCasesInScope</span><span class="merit-tile__label">Open cases in your scope</span></a></li>
</ul>

<section class="merit-section" aria-labelledby="urgent-heading">
    <h2 id="urgent-heading">Needs attention</h2>
    @if (Model.Data.UrgentItems.Count == 0)
    {
        <p class="merit-empty">No urgent or overdue work in this scope. Use the starting actions above to import a report, find a patient, or review assigned work. An empty queue does not mean no reports need entry.</p>
    }
    else
    {
        <div class="merit-table-wrap" tabindex="0" role="region" aria-label="Table; scroll sideways for more columns">
            <table class="usa-table usa-table--borderless">
                <thead><tr><th scope="col">Item</th><th scope="col">Detail</th><th scope="col">Due</th><th scope="col">Waiting since</th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Data.UrgentItems)
                    {
                        <tr>
                            <td>
                                @if (i.ExposureCaseId is Guid cid)
                                {
                                    <a class="usa-link" href="/cases/@cid">@i.Title</a>
                                }
                                else if (i.PersonId is Guid pid)
                                {
                                    <a class="usa-link" href="/people/@pid">@i.Title</a>
                                }
                                else if (i.ItemType == "heldGroup")
                                {
                                    @* One line per cause and sender, linking to that cause on Held records (issue #158). *@
                                    var query = new List<string> { "reason=" + Uri.EscapeDataString(i.ReasonCode ?? "") };
                                    if (i.SenderOrganizationId is Guid sid) { query.Add("sender=" + sid); }
                                    if (i.IntakeBatchId is Guid bid) { query.Add("batch=" + bid); }
                                    <a class="usa-link" href="/app/held?@string.Join("&", query)">@Options.Count(i.ItemCount, "elevated result") held: @Options.Humanize(i.ReasonCode)</a>
                                    <span class="merit-badge merit-badge--urgent">Urgent</span>
                                    <br /><span class="merit-meta">Held at intake@(i.SenderName is null ? "" : $" from {i.SenderName}")</span>
                                }
                                else
                                {
                                    @i.Title
                                }
                            </td>
                            <td>@i.Detail</td>
                            <td class="merit-nowrap">@Options.Date(i.DueDate)</td>
                            <td class="merit-nowrap">@Options.Date(i.WaitingSinceUtc)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="merit-section" aria-labelledby="queues-heading">
    <h2 id="queues-heading">Work queues <span class="merit-indicator htmx-indicator" id="queues-indicator">Refreshing&hellip;</span></h2>
    @* Counts refresh by polling this partial every 30 seconds; innerMorph keeps focus and scroll position. *@
    <div id="queue-tiles" hx-get="/home/queues" hx-trigger="every 30s" hx-swap="innerMorph" hx-indicator="#queues-indicator">
        <partial name="_QueueTiles" model="Model.Tiles" />
    </div>
</section>

<section class="merit-section" aria-labelledby="cases-heading">
    <h2 id="cases-heading">My recent cases</h2>
    @if (Model.Data.MyCases.Count == 0)
    {
        <p class="merit-empty">No open cases are assigned to you.</p>
    }
    else
    {
        <ul class="usa-list usa-list--unstyled">
            @foreach (var k in Model.Data.MyCases)
            {
                <li>
                    <a class="usa-link" href="/cases/@k.ExposureCaseId">@k.CaseNumber</a> &middot;
                    <a class="usa-link" href="/people/@k.PersonId">@k.LastName, @k.FirstName</a>
                    <span class="merit-badge merit-badge--@k.Classification">@Options.Humanize(k.Classification)</span>
                    <span class="merit-meta">opened @Options.Date(k.OpenedDate)</span>
                </li>
            }
        </ul>
    }
</section>
