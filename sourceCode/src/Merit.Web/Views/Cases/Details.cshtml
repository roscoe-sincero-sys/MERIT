@model CasePageModel
@{
    ViewData["Title"] = "Case " + Model.Detail.Case.CaseNumber;
}
<p><a class="usa-link" href="/cases">All cases</a></p>
<partial name="_Breadcrumbs" model='(IReadOnlyList<BreadcrumbItem>)[new("People", "/search"), new("Patient", $"/people/{Model.Detail.Case.PersonId}"), new("Case " + Model.Detail.Case.CaseNumber)]' />

<partial name="_CaseBody" model="Model" />
<partial name="_AuditLink" model='(Model.Detail.Case.ExposureCaseId, "case")' />
