@model CaseListModel
@{
    var f = Model.Filter;
    int first = (Model.PageNumber - 1) * CaseFilterModel.PageSize + 1;
    int last = first + Model.Rows.Count - 1;
    int pages = Math.Max(1, (Model.TotalCount + CaseFilterModel.PageSize - 1) / CaseFilterModel.PageSize);
    // Only the sorted column carries aria-sort: USWDS highlights every column that has it.
    string? AriaSort(string key) => f.Sort == key ? (f.Desc ? "descending" : "ascending") : null;
    // A column sorts its natural way first (newest opened, case number up, most serious first, A to Z), then reverses.
    // Sorting reloads the page, so the filter form keeps the sort for its next change.
    string SortHref(string key, bool firstDesc) => "/cases" + f.Query(1, key, f.Sort == key ? !f.Desc : firstDesc);
    string Arrow(string key) => f.Sort != key ? "" : f.Desc ? "▼" : "▲";
}
<div id="case-list-body">
    <p class="merit-meta" aria-live="polite">
        @if (Model.TotalCount == 0) { <text>No cases match.</text> }
        else { <text>Cases @first&ndash;@last of @Model.TotalCount</text> }
    </p>
    @if (Model.Rows.Count > 0)
    {
        <div class="merit-table-wrap" tabindex="0" role="region" aria-label="Cases; scroll sideways for more columns">
            <table class="usa-table usa-table--borderless">
                <caption class="usa-sr-only">Cases</caption>
                <thead>
                    <tr>
                        <th scope="col" aria-sort="@AriaSort("case")"><a class="merit-sort" href="@SortHref("case", false)" hx-get="@SortHref("case", false)" hx-target="#case-list" hx-swap="innerMorph" hx-push-url="true">Case <span aria-hidden="true">@Arrow("case")</span></a></th>
                        <th scope="col" aria-sort="@AriaSort("person")"><a class="merit-sort" href="@SortHref("person", false)" hx-get="@SortHref("person", false)" hx-target="#case-list" hx-swap="innerMorph" hx-push-url="true">Person <span aria-hidden="true">@Arrow("person")</span></a></th>
                        <th scope="col">Analyte</th>
                        <th scope="col" aria-sort="@AriaSort("classification")"><a class="merit-sort" href="@SortHref("classification", false)" hx-get="@SortHref("classification", false)" hx-target="#case-list" hx-swap="innerMorph" hx-push-url="true">Classification <span aria-hidden="true">@Arrow("classification")</span></a></th>
                        <th scope="col">Status</th>
                        <th scope="col" aria-sort="@AriaSort("opened")"><a class="merit-sort" href="@SortHref("opened", true)" hx-get="@SortHref("opened", true)" hx-target="#case-list" hx-swap="innerMorph" hx-push-url="true">Opened <span aria-hidden="true">@Arrow("opened")</span></a></th>
                        <th scope="col">Assigned</th>
                        <th scope="col">Owner</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Rows)
                    {
                        <tr id="case-@c.ExposureCaseId">
                            <td class="merit-nowrap"><a class="usa-link" href="/cases/@c.ExposureCaseId">@c.CaseNumber</a></td>
                            <td><a class="usa-link" href="/people/@c.PersonId">@c.LastName, @c.FirstName</a></td>
                            <td>@Options.Humanize(c.AnalyteCode)</td>
                            <td><span class="merit-badge merit-badge--@c.Classification">@Options.Humanize(c.Classification)</span> <span class="merit-badge merit-badge--@c.Population">@Options.Population(c.Population)</span></td>
                            <td>@Options.Humanize(c.CaseStatus)</td>
                            <td class="merit-nowrap">@Options.Date(c.OpenedDate)</td>
                            <td>@(c.AssignedToName ?? "Unassigned")</td>
                            <td>@c.OwningTenantName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (pages > 1)
        {
            <nav class="merit-pager" aria-label="Case list pages">
                @if (Model.PageNumber > 1)
                {
                    string prev = "/cases" + f.Query(Model.PageNumber - 1);
                    <a class="usa-button usa-button--outline" href="@prev" hx-get="@prev" hx-target="#case-list" hx-swap="innerMorph" hx-push-url="true">Previous page</a>
                }
                <span>Page @Model.PageNumber of @pages</span>
                @if (Model.PageNumber < pages)
                {
                    string next = "/cases" + f.Query(Model.PageNumber + 1);
                    <a class="usa-button usa-button--outline" href="@next" hx-get="@next" hx-target="#case-list" hx-swap="innerMorph" hx-push-url="true">Next page</a>
                }
            </nav>
        }
    }
</div>
