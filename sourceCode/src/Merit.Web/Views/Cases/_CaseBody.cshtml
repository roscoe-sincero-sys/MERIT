@model CasePageModel
@{
    var draft = Model.Draft ?? FormDraft.Empty;
    var c = Model.Detail.Case;
    string rv = Options.Hex(c.RowVersion);
    bool allResults = Context.Request.Query["results"] == "all";
    var displayedResults = allResults ? Model.Detail.Results : Model.Detail.Results.Where(r => r.Membership == "currentEpisode").ToList();
}
<div id="case-body" data-preserve-drafts hx-get="/cases/@c.ExposureCaseId" hx-trigger="merit:caseBody from:body" hx-swap="outerHTML">
    @if (c.CaseStatus == "closed" && User.HasClaim(MeritClaims.Permission, Permissions.CaseEdit)) {
        <form id="case-reopen-form" class="usa-form" hx-post="/cases/@c.ExposureCaseId/reopen" hx-target="#case-body" hx-swap="outerHTML">
            <input type="hidden" name="rowVersion" value="@draft.Value("reopen", "rowVersion", rv)" />
            <label class="usa-label" for="reopen-reason">Reason for reopening</label><textarea class="usa-textarea" id="reopen-reason" name="reason" required maxlength="2000">@draft.Value("reopen", "reason")</textarea>
            <button class="usa-button" type="submit">Reopen case</button>
        </form>
    }
    <div class="merit-page-header">
        <h1>Case @c.CaseNumber</h1>
        <p>
            <span class="merit-badge merit-badge--@c.Classification">@Options.Humanize(c.Classification)</span>
            <span class="merit-badge">@Options.Humanize(c.CaseStatus)</span>
            <span class="merit-badge merit-badge--@c.Population">@Options.Population(c.Population)</span>
        </p>
    </div>
    <div class="workspace-context" aria-label="Case context"><strong>@c.LastName, @c.FirstName</strong> | Case @c.CaseNumber | @c.AnalyteName</div>
    <nav class="workspace-sections" aria-label="Case sections"><a href="#case-summary">Overview</a><a href="#case-tasks">Tasks</a><a href="#case-results">Lab results</a><a href="#case-activities">Activity</a><a href="/people/@c.PersonId/care?caseId=@c.ExposureCaseId#documents">Documents</a>@if(Model.CanEdit) { <a href="#close-heading">Closure review</a> }</nav>
    <p><a class="usa-button usa-button--outline" href="/people/@c.PersonId/care?caseId=@c.ExposureCaseId">Case activities, notification deadlines and documents</a></p>
    @if (Model.Message is not null)
    {
        <div class="usa-alert usa-alert--info usa-alert--slim" role="status"><div class="usa-alert__body"><p class="usa-alert__text">@Model.Message</p></div></div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <partial name="_ErrorSummary" model='new ErrorSummaryModel(["reason", "assignedToUserId", "exposureCategory", "caseStatus", "activityType", "activityDate", "outcome", "contactPersonId", "note", "classification", "population", "closureReason", "closedDate"], new Dictionary<string, string> { ["reason"] = "reason", ["assignedToUserId"] = "assignedToUserId", ["exposureCategory"] = "exposureCategory", ["caseStatus"] = "caseStatus", ["activityType"] = "activityType", ["activityDate"] = "activityDate", ["outcome"] = "outcome", ["contactPersonId"] = "contactPersonId", ["note"] = "closeNote", ["classification"] = "classification", ["population"] = "population", ["closureReason"] = "closureReason", ["closedDate"] = "closedDate" }, SummaryId: "cases-casebody-errors")' />
    }
    <div class="merit-grid-2">
        <section class="merit-section" aria-labelledby="case-summary">
            <h2 id="case-summary">Summary</h2>
            <dl>
                <dt>Person</dt><dd><a class="usa-link" href="/people/@c.PersonId">@c.LastName, @c.FirstName</a> @(c.Dob is null ? "" : "b. " + Options.Date(c.Dob))</dd>
                <dt>Substance tested</dt><dd>@c.AnalyteName</dd>
                <dt>Classification</dt><dd>@Options.Humanize(c.Classification)@(c.Classification != c.ComputedClassification ? $" (computed: {c.ComputedClassification})" : "")
                    @if (c.OverrideReason is not null) { <div class="merit-meta">Override reason: @c.OverrideReason</div> }</dd>
                <dt>Recorded highest result</dt><dd>@Options.Value("=", c.HighestValue, c.HighestUnit ?? "") on @Options.Date(c.HighestCollectedDate)
                    @if(c.HighestLabResultId is Guid highest) { <a href="/results/@highest?caseId=@c.ExposureCaseId">Review source result</a> }
                    @if(c.HighestResultRowStatus is not null and not "valid") { <p><strong>Review required: this recorded highest result is @Options.Humanize(c.HighestResultRowStatus).</strong> Case classification has not been automatically downgraded. Review the replacement, tasks and notification evidence.</p> }
                </dd>
                <dt>Workflow</dt><dd>@Options.Humanize(c.WorkflowTemplate)</dd>
                <dt>Owner</dt><dd>@c.OwningTenantName</dd>
                <dt>Opened</dt><dd>@Options.Date(c.OpenedDate)@(c.ClosedDate is null ? "" : ", closed " + Options.Date(c.ClosedDate) + " (" + Options.Humanize(c.ClosureReason) + ")")</dd>
                @if (Model.Detail.PrimaryContact is { } pc)
                {
                    <dt>Primary contact</dt><dd><a class="usa-link" href="/people/@pc.ContactPersonId">@pc.FirstName @pc.LastName</a> (@Options.Humanize(pc.Role)) @pc.Phone</dd>
                }
            </dl>
            @if (Model.CanEdit)
            {
                <form class="usa-form" id="case-update-form" hx-post="/cases/@c.ExposureCaseId/update" hx-target="#case-body" hx-swap="outerHTML">
                    <input type="hidden" name="rowVersion" value="@draft.Value("update", "rowVersion", rv)" />
                    <div class="merit-form-row">
                        <div class="usa-form-group"><label class="usa-label" for="assignedToUserId">Assigned to</label>
                            <select class="usa-select" id="assignedToUserId" name="assignedToUserId">@foreach (var o in Model.Users) { <option value="@o.Value" selected="@(draft.Selected("update", "assignedToUserId", o))">@o.Label</option> }</select></div>
                        <div class="usa-form-group"><label class="usa-label" for="exposureCategory">Exposure category</label>
                            <select class="usa-select" id="exposureCategory" name="exposureCategory">@foreach (var o in Options.Fixed(draft.Value("update", "exposureCategory", c.ExposureCategory), Options.ExposureCategories)) { <option value="@o.Value" selected="@o.Selected">@o.Label</option> }</select></div>
                        <div class="usa-form-group"><label class="usa-label" for="caseStatus">Status</label>
                            <select class="usa-select" id="caseStatus" name="caseStatus"><option value="open" selected="@(draft.Value("update", "caseStatus", c.CaseStatus) == "open")">Open</option><option value="monitoring" selected="@(draft.Value("update", "caseStatus", c.CaseStatus) == "monitoring")">Monitoring</option></select></div>
                    </div>
                    <button class="usa-button" type="submit">Save</button>
                </form>
            }
        </section>

        <section class="merit-section" aria-labelledby="case-tasks">
            <h2 id="case-tasks">Open tasks</h2>
            @if (Model.Detail.Tasks.Count == 0) { <p class="merit-empty">No open tasks.</p> }
            else
            {
                <ul class="usa-list">
                    @foreach (var t in Model.Detail.Tasks)
                    {
                        <li>@if (t.IsUrgent) { <span class="merit-badge merit-badge--urgent">Urgent</span> } <strong>@t.Title</strong>
                            @(t.DueDate is null ? "" : "· due " + Options.Date(t.DueDate)) <div class="merit-meta">@t.Detail</div>
                            @if(t.QueueCode == "notificationDue") { <a href="/people/@c.PersonId/care?caseId=@c.ExposureCaseId#notifications">Record notification evidence</a> }
                            else if(t.QueueCode == "assessmentOwnerClosure") { <a href="/app/queues?queue=assessmentOwnerClosure">Record closure-letter evidence or ownership exemption in the queue</a> }
                            else if (t.CanEdit) { <form hx-post="/cases/@c.ExposureCaseId/tasks/@t.WorkTaskId" hx-target="#case-body" hx-swap="outerHTML">
                                <button class="usa-button usa-button--unstyled" type="submit" name="action" value="assignToMe">Assign to me</button>
                            </form><a href="/work/tasks/@t.WorkTaskId">Record task outcome and evidence</a> }
                        </li>
                    }
                </ul>
                <p><a class="usa-link" href="/app/queues">Work these in the queue</a></p>
            }
            <h2>Investigations</h2>
            @if (Model.Detail.Investigations.Count == 0) { <p class="merit-empty">No investigations yet.</p> }
            else
            {
                <ul class="usa-list">
                    @foreach (var i in Model.Detail.Investigations)
                    {
                        <li><a class="usa-link" href="/investigations/@i.InvestigationId?caseId=@c.ExposureCaseId">@i.InvestigationNumber</a> &middot; @Options.Humanize(i.InvestigationType) &middot; @i.TargetLabel @i.TargetCity &middot; @Options.Humanize(i.InvestigationStatus)</li>
                    }
                </ul>
            }
            @if (Model.CanInvestigate && c.CaseStatus != "closed")
            {
                <button class="usa-button usa-button--outline" type="button" id="case-request-investigation" disabled="@(!Model.HasInvestigationTargets)" hx-get="/cases/@c.ExposureCaseId/investigations/new" hx-target="#dialog-body" hx-swap="innerHTML">Request an investigation</button>
                @if (!Model.HasInvestigationTargets)
                {
                    @* Add the place here rather than detour through the person page (issue #150). *@
                    <p id="investigation-needs-place">An investigation needs a place or employer on the person's record.
                        @if (User.HasClaim(MeritClaims.Permission, Permissions.PersonEdit))
                        {
                            <button class="usa-button usa-button--unstyled" type="button" id="case-add-place" hx-get="/people/@c.PersonId/places/add?forCase=@c.ExposureCaseId" hx-target="#dialog-body" hx-swap="innerHTML">Add a place now</button>
                        }
                        else { <a class="usa-link" href="/people/@c.PersonId">Open the person record</a> }
                    </p>
                }
            }
        </section>
    </div>

    <section class="merit-section" aria-labelledby="case-results">
        <h2 id="case-results">@(allResults ? "All patient results for this substance" : "Results recorded in the current case episode")</h2>
        <p>Results belong to an episode only when MERIT recorded that association. Earlier results and legacy records remain available as context; collection dates alone do not establish membership. Lower results do not automatically resolve a case.</p>
        <p><a href="/cases/@c.ExposureCaseId?results=@(allResults ? "current" : "all")#case-results">@(allResults ? "Show current episode only" : "Show all patient results, including earlier and unassigned context")</a></p>
        @if(displayedResults.Count == 0) { <p>No result associations were recorded for this episode. <a href="/cases/@c.ExposureCaseId?results=all#case-results">Review all patient results and legacy case evidence</a>.</p> }
        <div class="merit-table-wrap" tabindex="0" role="region" aria-label="Table; scroll sideways for more columns">
            <table class="usa-table usa-table--borderless usa-table--compact">
                <thead><tr><th scope="col">Sample collection date</th><th scope="col">Value</th><th scope="col">Sample</th><th scope="col">Method</th><th scope="col">Laboratory result status</th><th scope="col">Lab</th></tr></thead>
                <tbody>
                    @foreach (var r in displayedResults)
                    {
                        <tr class="@(r.LabResultId == c.QualifyingLabResultId ? "text-bold" : "")">
                            <td><a class="usa-link" href="/results/@r.LabResultId?caseId=@c.ExposureCaseId">@Options.Date(r.CollectedDate)</a>@(r.LabResultId == c.QualifyingLabResultId ? " (qualifying)" : "")</td>
                            <td>@Options.Value(r.Operator, r.ValueCanonical, r.UnitCanonical)</td>
                            <td>@Options.Humanize(r.SampleType)</td>
                            <td>@Options.Humanize(r.TestMethod)</td>
                            <td>@Options.Humanize(r.ResultStatus) @(r.ResultRowStatus == "valid" ? "" : "· " + r.ResultRowStatus)</td>
                            <td>@r.LabName<br /><small>@(r.Membership switch { "currentEpisode" => "Current episode", "earlierOrUnknownEpisode" => "Associated with this case; earlier or unrecorded episode", "legacyCaseResult" => "Legacy qualifying/highest result; episode unrecorded", _ => "Patient context; no recorded case association" })</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="merit-section" aria-labelledby="case-history">
        <h2 id="case-history">Case opening, closure and reopening history</h2>
        <p>Original opening: @Options.Date(c.OpenedDate). Current status: <strong>@Options.Humanize(c.CaseStatus)</strong>. Reopening does not erase an earlier closure. Legacy untyped status events are included verbatim; missing dates or reasons are not inferred.</p>
        <ol class="usa-list">
        @foreach(var a in Model.Detail.Activities.Where(a => a.ActivityType=="statusChange" && !a.IsVoided).OrderBy(a => a.ActivityDate).ThenBy(a => a.CreatedDateUtc)) {
            <li><strong>@Options.Date(a.ActivityDate)</strong> &middot; @a.WorkerName &middot; @a.Note</li>
        }
        </ol>
    </section>
    <section class="merit-section" aria-labelledby="case-activities">
        <h2 id="case-activities">Activity log</h2>
        @if (Model.Detail.Activities.Count == 0) { <p class="merit-empty">No activity yet.</p> }
        else
        {
            <ol class="usa-list usa-list--unstyled">
                @foreach (var a in Model.Detail.Activities)
                {
                    <li class="margin-bottom-1">@if(a.IsVoided) { <strong>Withdrawn evidence: @a.VoidReason</strong> } <strong>@Options.Date(a.ActivityDate)</strong> &middot; @Options.Humanize(a.ActivityType)@(a.Outcome is null ? "" : " · " + Options.Humanize(a.Outcome))
                        @if (a.ContactLastName is not null) { <span>&middot; with @a.ContactFirstName @a.ContactLastName</span> }
                        <span class="merit-meta">&middot; @a.WorkerName</span><div>@a.Note</div></li>
                }
            </ol>
        }
        @if (Model.CanEdit)
        {
            <h3 id="case-activity-new">Log an activity</h3>
            <form class="usa-form merit-inline-form" id="case-activity-form" aria-labelledby="case-activity-new" hx-post="/cases/@c.ExposureCaseId/activities" hx-target="#case-body" hx-swap="outerHTML">
                <div class="merit-form-row">
                    <div class="usa-form-group"><label class="usa-label" for="activityType">Activity</label>
                        <select class="usa-select" id="activityType" name="activityType">@foreach (var o in Model.ActivityTypes) { <option value="@o.Value" selected="@(draft.Selected("activity", "activityType", o))">@o.Label</option> }</select></div>
                    <div class="usa-form-group"><label class="usa-label" for="activityDate">Date</label><input class="usa-input" id="activityDate" name="activityDate" type="date" value="@draft.Value("activity", "activityDate", Options.Iso(Clock.Today))" /></div>
                    <div class="usa-form-group"><label class="usa-label" for="outcome">Outcome</label>
                        <select class="usa-select" id="outcome" name="outcome">@foreach (var o in Model.Outcomes) { <option value="@o.Value" selected="@(draft.Selected("activity", "outcome", o))">@o.Label</option> }</select></div>
                </div>
                <label class="usa-label" for="contactPersonId">Contacted person</label><select class="usa-select" id="contactPersonId" name="contactPersonId">
                    @foreach (var contact in Model.ContactOptions ?? []) { <option value="@contact.Value" selected="@(draft.Value("activity", "contactPersonId", "") == contact.Value)">@contact.Label</option> }
                </select>
                <div class="usa-form-group"><label class="usa-label" for="note">Note</label><textarea class="usa-textarea" id="note" name="note" rows="2" maxlength="2000">@draft.Value("activity", "note")</textarea></div>
                <button class="usa-button" type="submit">Log activity</button>
            </form>
        }
    </section>

    @if (Model.CanEdit)
    {
        @* Consequential changes wait behind their own disclosure, each saying what it does (issue #159). A form whose
           submission failed re-renders open, so its errors and draft are in view. *@
        <div class="merit-grid-2">
            <section class="merit-section" aria-labelledby="override-heading">
                <h2 id="override-heading">Classification override</h2>
                <details class="merit-details" id="case-override-details" data-preserve-open open="@(draft.Form == "override")">
                <summary>Change classification&hellip;</summary>
                <p id="override-consequence">The classification and population you choose replace the computed ones on this case. The computed classification stays shown beside it, and your reason is kept with the change.</p>
                <form class="usa-form" id="case-override-form" hx-post="/cases/@c.ExposureCaseId/override" hx-target="#case-body" hx-swap="outerHTML">
                    <input type="hidden" name="rowVersion" value="@draft.Value("override", "rowVersion", rv)" />
                    <div class="merit-form-row">
                        <div class="usa-form-group"><label class="usa-label" for="classification">Classification</label>
                            <select class="usa-select" id="classification" name="classification"><option value="confirmed" selected="@(draft.Value("override", "classification", c.Classification) == "confirmed")">Confirmed</option><option value="suspect" selected="@(draft.Value("override", "classification", c.Classification) == "suspect")">Suspect</option><option value="notACase" selected="@(draft.Value("override", "classification", c.Classification) == "notACase")">Not a case</option></select></div>
                        <div class="usa-form-group"><label class="usa-label" for="population">Population</label>
                            <select class="usa-select" id="population" name="population"><option value="child" selected="@(draft.Value("override", "population", c.Population) == "child")">Child</option><option value="adult" selected="@(draft.Value("override", "population", c.Population) == "adult")">Adult</option><option value="pregnant" selected="@(draft.Value("override", "population", c.Population) == "pregnant")">Pregnant</option></select></div>
                    </div>
                    <div class="usa-form-group"><label class="usa-label" for="reason">Reason (required)</label><input class="usa-input" id="reason" name="reason" value="@draft.Value("override", "reason")" required /></div>
                    <button class="usa-button usa-button--outline" type="submit" aria-describedby="override-consequence">Override</button>
                </form>
                </details>
            </section>
            @if (Model.TransferTargets is { Count: > 0 } targets)
            {
            <section class="merit-section" aria-labelledby="transfer-heading">
                <h2 id="transfer-heading">Transfer case</h2>
                <details class="merit-details" id="case-transfer-details" data-preserve-open open="@(draft.Form == "transfer")">
                <summary>Transfer to another jurisdiction&hellip;</summary>
                <p id="transfer-consequence">Now owned by <strong>@c.OwningTenantName</strong>. The receiving jurisdiction takes over the case with its history, tasks, notification obligations, sources, documents and the investigations only this case uses. A worker who cannot work there is unassigned. You may lose access to the case afterwards.</p>
                <form class="usa-form" id="case-transfer-form" hx-post="/cases/@c.ExposureCaseId/transfer" hx-target="#case-body" hx-swap="outerHTML">
                    <input type="hidden" name="rowVersion" value="@draft.Value("transfer", "rowVersion", rv)" />
                    <div class="usa-form-group"><label class="usa-label" for="toTenantId">Receiving jurisdiction</label>
                        <select class="usa-select" id="toTenantId" name="toTenantId" required>@foreach (var o in targets) { <option value="@o.Value" selected="@(draft.Selected("transfer", "toTenantId", o))">@o.Label</option> }</select></div>
                    <div class="usa-form-group"><label class="usa-label" for="transferReason">Reason (required)</label><input class="usa-input" id="transferReason" name="transferReason" maxlength="500" value="@draft.Value("transfer", "transferReason")" required /></div>
                    <div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" name="transferConfirmed" id="transferConfirmed" value="true" required /><label class="usa-checkbox__label" for="transferConfirmed">The receiving jurisdiction has agreed to take over this case.</label></div>
                    <button class="usa-button usa-button--outline" type="submit" aria-describedby="transfer-consequence">Transfer case</button>
                </form>
                </details>
            </section>
            }
            <section class="merit-section" aria-labelledby="close-heading">
                <h2 id="close-heading">Close case</h2>
                <details class="merit-details" id="case-close-details" data-preserve-open open="@(draft.Form == "close")">
                <summary>Close case&hellip;</summary>
                <h3>Outstanding work review</h3>
                @foreach(var requirement in Model.Detail.ClosureRequirements ?? []) { <p><strong>@requirement.Name:</strong> governs @Options.Humanize(requirement.ClosureReason) closure; @requirement.MinimumContactAttempts unsuccessful attempts required. @Options.Humanize(requirement.EvaluationState): @requirement.Explanation</p> }
                <p>@Model.Detail.Tasks.Count open tasks on this case. @c.FailedContactAttempts recorded unsuccessful contact attempts with an identified recipient. <a href="/people/@c.PersonId/work">Review program requirements, exceptions and transferred work</a>.</p>
                <ul class="usa-list">@foreach(var task in Model.Detail.Tasks) { <li><a href="/work/tasks/@task.WorkTaskId">@task.Title</a> - remains required if its policy governs the selected closure reason; routine work will be recorded as automatically dismissed.</li> }</ul>
                <p id="close-consequence">Closing dismisses routine case tasks. Required notification evidence must be resolved first. A Maryland unreachable-family closure requires documented contact/letter evidence and retains a property-owner closure-letter review task until resolved.</p>
                <p>For Maryland childhood blood lead cases closed below level, <a href="/people/@c.PersonId/care/testing">review testing and remediation readiness</a> first. The latest two consecutive low tests must be at least three calendar months apart, and clinical testing plans must be resolved.</p>
                <form class="usa-form" id="case-close-form" hx-post="/cases/@c.ExposureCaseId/close" hx-target="#case-body" hx-swap="outerHTML" data-confirm="Close this case? Routine case tasks will be recorded as automatically dismissed. Required notification and program evidence must be resolved first. Unsaved entries in other sections will be discarded when editing closes.">
                    <input type="hidden" name="closureReviewToken" value="@c.ClosureReviewToken" />
                    <input type="hidden" name="rowVersion" value="@draft.Value("close", "rowVersion", rv)" />
                    <div class="merit-form-row">
                        <div class="usa-form-group"><label class="usa-label" for="closureReason">Reason</label>
                            <select class="usa-select" id="closureReason" name="closureReason" required>@foreach (var o in Model.ClosureReasons) { <option value="@o.Value" selected="@(draft.Selected("close", "closureReason", o))">@o.Label</option> }</select></div>
                        <div class="usa-form-group"><label class="usa-label" for="closedDate">Closed date</label><input class="usa-input" id="closedDate" name="closedDate" type="date" value="@draft.Value("close", "closedDate", Options.Iso(Clock.Today))" /></div>
                    </div>
                    <div class="usa-form-group"><label class="usa-label" for="closeNote">Note</label><input class="usa-input" id="closeNote" name="note" value="@draft.Value("close", "note")" /></div>
                    <div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" name="closureReviewConfirmed" id="closureReviewConfirmed" value="true" required /><label class="usa-checkbox__label" for="closureReviewConfirmed">I reviewed these current tasks and their required, waived/transferred, or automatic-dismissal disposition for this closure reason.</label></div>
                    <button class="usa-button usa-button--secondary" type="submit" aria-describedby="close-consequence">Close case</button>
                </form>
                </details>
            </section>
        </div>
    }
</div>
