@model TestingPlanModel
@inject ICurrentSession Session
@{
    ViewData["Title"] = "Blood lead testing plan";
    var patient = Model.Person.Header.Person;
    string root = $"/people/{patient.PersonId}/care/testing";
    string V(string key, string fallback = "") => ViewData.ModelState.TryGetValue(key, out var e) ? e.AttemptedValue ?? fallback : fallback;
    var bloodResults = Model.Person.Results.Where(r => r.AnalyteCode == "PB" && r.Specimen == "wholeBlood" && r.UnitCanonical == "ug/dL").ToArray();
    bool policyActive = patient.TestingPolicyVersion == "MDH-2025-03";
    bool edit = policyActive && Session.Has(Permissions.PersonEdit) && Session.Has(Permissions.TaskEdit);
}
<p><a href="/people/@patient.PersonId/care">Back to patient follow-up</a></p>
<h1>Blood lead testing plan</h1>
<p><strong>@patient.LastName, @patient.FirstName</strong> · Birth date: @patient.Dob</p>
@if (!policyActive) {
<p>No testing policy is active for this patient's state. Ask the state administrator to configure an approved policy.</p>
@if(!ViewData.ModelState.IsValid) { <div class="usa-alert usa-alert--error" role="alert"><div asp-validation-summary="All"></div></div> }
} else {
<p>Maryland childhood guidance. These are provider testing plans, separate from Department notification and laboratory reporting deadlines. Verify Maryland applicability, outside records and the clinician's assessment before saving. School/child-care testing certificates are not tracked here.</p>
<p><a href="https://mde.maryland.gov/programs/land/LeadPoisoningPrevention/Documents/Reports/MDH%202025%20Maryland%20Guidelines%20for%20Lead%20Exposure.pdf">MDH March 2025 clinical guidance (Tables 1, 2, 4 and 6)</a> · <a href="https://regs.maryland.gov/us/md/exec/comar/10.11.04.04">COMAR screening requirements</a></p>
<details><summary>How targets and source draws work</summary>
<p>Screen at 12 and 24 months. Missing proof requires source review; arrange catch-up promptly, before age 6. A test before 24 months cannot satisfy the 24-month plan. Catch-up remains dated when actually performed; it does not establish timely birthday screening.</p>
<p>Confirmation starts at the first unresolved elevated capillary draw in the reviewed episode. Below-level capillary tests and later elevated capillary tests do not restart it. A venous result is required to complete confirmation even if two capillary tests meet the separate legal EBL definition.</p>
<p>Confirmation windows: configured elevated reference level to under 10 µg/dL: 12 weeks; 10 to under 20: 4 weeks; 20 to under 45: 2 weeks; 45 or higher: within 48 hours. For 45 or higher, coordinate urgently now and verify the actual draw timestamp; a date-only result cannot establish the exact cutoff.</p>
<p>Follow-up starts at the reviewed venous draw, not receipt. Early follow-up covers the first 2–4 tests; later follow-up requires clinician-reviewed decline. Default targets use the end of the guidance range; choose an earlier date when indicated. At 45 or higher, coordinate urgently under the treatment plan. Below-reference monitoring uses three calendar months toward reviewed closure.</p>
<p>Below-level closure requires completed environmental remediation and the latest two consecutive low tests at least three calendar months apart. A new elevated or uncertain result invalidates readiness. Readiness review does not close the case.</p>
</details>
@if(TempData["CareMessage"] is string message) { <div class="usa-alert usa-alert--success" role="status"><p>@message</p></div> }
@if(!ViewData.ModelState.IsValid) { <div class="usa-alert usa-alert--error" role="alert"><h2>Testing plan was not saved</h2><div asp-validation-summary="All"></div></div> }
<section class="merit-section"><h2>Plans and clinical review history</h2>
@if(Model.Plans.Count == 0) { <p>No reviewed testing plans. This does not establish that screening or follow-up is complete.</p> }
@foreach(var p in Model.Plans) {
<article class="merit-section" id="plan-@p.WorkTaskId"><h3>@p.Title — @Options.Humanize(p.TaskStatus) @(p.IsUrgent ? "· Urgent clinician coordination" : "")</h3>
<p>Target: @(p.DueDate?.ToString("yyyy-MM-dd") ?? "Clinical review required") · <strong>@TestingDisplay.Status(p.TaskStatus, p.DueDate, Clock.Today)</strong> · Assigned to: @(p.AssignedToName ?? "Unassigned")</p>
<p class="care-note">@p.Detail</p>
@if(p.LabResultId is not null) { <p><a href="/results/@p.LabResultId">Original source draw</a></p> }
@if(p.CompletedResultId is Guid actual) { <p><a href="/results/@actual">Actual completed test</a></p> }
@if(p.ExposureCaseId is not null) { <p><a href="/cases/@p.ExposureCaseId">Associated case</a></p> }
@if(p.CompletedUtc is DateTime done) { <p>Recorded @Clock.ToLocal(done).ToString("yyyy-MM-dd HH:mm"): @p.ResolutionNote</p> }
@if(edit && p.TaskStatus == "open" && p.QueueCode == "testingFollowUp" && (p.ExposureCaseId is null || Session.Has(Permissions.CaseEdit))) {
<details><summary>Record actual test or clinical reason to stop this plan</summary>
<form asp-antiforgery="true" method="post" action="@root/resolve" class="usa-form" data-unsaved-work>
<input type="hidden" name="workTaskId" value="@p.WorkTaskId" />
<label class="usa-label" for="outcome-@p.WorkTaskId">Outcome</label><select class="usa-select" name="dismiss" id="outcome-@p.WorkTaskId"><option value="false">Test actually completed</option><option value="true">Dismiss with clinician/source-based reason</option></select>
<label class="usa-label" for="result-@p.WorkTaskId">Actual completed blood test (required for completion)</label><select class="usa-select" name="completedLabResultId" id="result-@p.WorkTaskId"><option value="">Choose result</option>@foreach(var r in bloodResults) { <option value="@r.LabResultId">@r.CollectedDate · @r.Operator @r.ValueCanonical @r.UnitCanonical · @r.SampleType · @r.ResultRowStatus</option> }</select>
<label class="usa-label" for="evidence-@p.WorkTaskId">Source evidence / clinical reason</label><textarea class="usa-textarea" name="evidence" id="evidence-@p.WorkTaskId" required maxlength="1000">@V("evidence")</textarea>
<div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" name="confirmed" id="confirmed-@p.WorkTaskId" value="true" required /><label class="usa-checkbox__label" for="confirmed-@p.WorkTaskId">I verified the actual test or the documented clinical reason.</label></div>
<button class="usa-button">Save testing outcome</button></form></details>
}
</article>
}
</section>
@if(edit) {
<section class="merit-section"><h2>Record a clinician-approved plan</h2>
<form asp-antiforgery="true" class="usa-form" method="post" action="@root" id="testing-plan-form" data-unsaved-work>
<input type="hidden" name="workTaskId" value="@V("workTaskId", Guid.NewGuid().ToString())" />
<label class="usa-label" for="planKind">Testing stage</label><select class="usa-select" id="planKind" name="planKind">@foreach(var k in new[] { ("screen12","12-month screening / missed screening"), ("screen24","24-month screening / missed screening"), ("confirmation","Confirm initial elevated capillary result with venous sample"), ("early","Early venous follow-up / below-reference monitoring"), ("later","Later venous follow-up after clinician-reviewed decline"), ("discharge","Review readiness for below-level case closure") }) { <option value="@k.Item1" selected="@(V("planKind", "confirmation") == k.Item1)">@k.Item2</option> }</select>
<label class="usa-label" for="testingCase">Associated active case (optional except closure review)</label><select class="usa-select" name="exposureCaseId" id="testingCase"><option value="">Patient only</option>@foreach(var c in Model.Person.Cases.Where(c => c.CaseStatus != "closed" && c.AnalyteCode == "PB")) { <option value="@c.ExposureCaseId" selected="@(V("exposureCaseId") == c.ExposureCaseId.ToString())">@c.CaseNumber</option> }</select>
<label class="usa-label" for="testingSource">Source draw (initial capillary, latest reviewed venous, or latest low test)</label><select class="usa-select" name="labResultId" id="testingSource"><option value="">Not required for age-based screening</option>@foreach(var r in bloodResults) { <option value="@r.LabResultId" selected="@(V("labResultId") == r.LabResultId.ToString())">@r.CollectedDate · @r.Operator @r.ValueCanonical @r.UnitCanonical · @r.SampleType · @r.ResultRowStatus</option> }</select>
<label class="usa-label" for="targetDate">Clinician-selected target date (optional; blank uses guideline target)</label><input class="usa-input" type="date" id="targetDate" name="targetDate" value="@V("targetDate")" />
<label class="usa-label" for="testingEvidence">Clinician plan and source evidence</label><textarea class="usa-textarea" id="testingEvidence" name="evidence" required maxlength="1000">@V("evidence")</textarea>
<div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" id="remediationConfirmed" name="remediationConfirmed" value="true" /><label class="usa-checkbox__label" for="remediationConfirmed">For below-level closure: environmental remediation is complete; the evidence above identifies the work and verification.</label></div>
<div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" id="clinicianConfirmed" name="clinicianConfirmed" value="true" required /><label class="usa-checkbox__label" for="clinicianConfirmed">I verified Maryland applicability, source history, episode/decline stage and the clinician-approved plan. Urgent results require immediate clinical coordination.</label></div>
<details><summary>Source draw or screening target before March 2025</summary>
<p>This workspace supports current care using March 2025 guidance. It cannot reconstruct an approved historical policy. For an older source, record the clinician's explicit decision to use current guidance. This decision does not establish the deadline that applied historically.</p>
<div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" id="currentGuidanceConfirmed" name="currentGuidanceConfirmed" value="true" checked="@(V("currentGuidanceConfirmed") == "true")" /><label class="usa-checkbox__label" for="currentGuidanceConfirmed">The clinician explicitly chose current guidance for current care of this older source.</label></div>
<label class="usa-label" for="currentGuidanceReason">Why current guidance applies to this older source</label><textarea class="usa-textarea" id="currentGuidanceReason" name="currentGuidanceReason" maxlength="1000">@V("currentGuidanceReason")</textarea>
</details>
<button class="usa-button">Save reviewed testing plan</button></form></section>
}

}
