@model InvestigationListModel
@{
    var filter = Model.Filter ?? new InvestigationFilterModel();
    int pages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / 25d));
    string Link(int page, string? sort = null) => Url.Action("Index", "Investigations", new { filter.OpenOnly, filter.Q, filter.Assigned, filter.Status, filter.Type,
        sort = sort ?? filter.Sort, desc = sort is null ? filter.Desc : filter.Sort == sort ? !filter.Desc : false, page })!;
}
<p role="status">@Model.TotalCount investigations. Page @Model.PageNumber of @pages.</p>
<p>Sort: <a href="@Link(1, "number")" hx-get="@Link(1, "number")" hx-target="#investigation-list" hx-push-url="true">Number</a> &middot; <a href="@Link(1, "requested")" hx-get="@Link(1, "requested")" hx-target="#investigation-list" hx-push-url="true">Requested date</a> &middot; <a href="@Link(1, "status")" hx-get="@Link(1, "status")" hx-target="#investigation-list" hx-push-url="true">Status</a></p>
<div id="investigation-list-body">
    @if (Model.Rows.Count == 0)
    {
        <p class="merit-empty">No investigations match.</p>
    }
    else
    {
        <div class="merit-table-wrap" tabindex="0" role="region" aria-label="Table; scroll sideways for more columns">
            <table class="usa-table usa-table--borderless">
                <thead><tr><th scope="col">Number</th><th scope="col">Type</th><th scope="col">Target</th><th scope="col">Status</th><th scope="col">Requested</th><th scope="col">Scheduled</th><th scope="col">Assigned</th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Rows)
                    {
                        <tr id="inv-@i.InvestigationId">
                            <td><a class="usa-link" href="/investigations/@i.InvestigationId">@i.InvestigationNumber</a></td>
                            <td>@Options.Humanize(i.InvestigationType)</td>
                            <td>@i.TargetLabel</td>
                            <td>@Options.Humanize(i.InvestigationStatus)</td>
                            <td>@Options.Date(i.RequestedDate)</td>
                            <td>@Options.Date(i.ScheduledDate)</td>
                            <td>@i.AssignedToName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<nav aria-label="Investigation pages">
    @if (Model.PageNumber > 1) { <a class="usa-button usa-button--outline" href="@Link(Model.PageNumber - 1)" hx-get="@Link(Model.PageNumber - 1)" hx-target="#investigation-list" hx-push-url="true">Previous page</a> }
    @if (Model.PageNumber < pages) { <a class="usa-button usa-button--outline" href="@Link(Model.PageNumber + 1)" hx-get="@Link(Model.PageNumber + 1)" hx-target="#investigation-list" hx-push-url="true">Next page</a> }
</nav>
