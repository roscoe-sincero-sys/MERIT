@model InvestigationListModel
@{
    ViewData["Title"] = "Investigations";
}
<h1>Investigations</h1>
<form class="usa-form merit-form-row" method="get" action="/investigations" hx-get="/investigations" hx-target="#investigation-list" hx-swap="innerMorph" hx-trigger="change, submit" hx-push-url="true">
    <div class="usa-checkbox"><input class="usa-checkbox__input" id="openOnly" type="checkbox" name="openOnly" value="true" checked="@(Model.OpenOnly)" /><label class="usa-checkbox__label" for="openOnly">Open only</label></div>
    <input type="hidden" name="openOnly" value="false" />
    <div><label class="usa-label" for="inv-q">Number, address or employer</label><input class="usa-input" id="inv-q" name="q" value="@Model.Filter?.Q" /></div>
    <div><label class="usa-label" for="inv-assigned">Investigator</label><select class="usa-select" id="inv-assigned" name="assigned">
        <option value="">Anyone</option><option value="me" selected="@(Model.Filter?.Assigned == "me")">Assigned to me</option><option value="unassigned" selected="@(Model.Filter?.Assigned == "unassigned")">Unassigned</option>
        @foreach (var user in Model.Users ?? []) { <option value="@user.Value" selected="@(Model.Filter?.Assigned == user.Value)">@user.Label</option> }
    </select></div>
    <div><label class="usa-label" for="inv-status">Status</label><select class="usa-select" id="inv-status" name="status"><option value="">Any</option>@foreach (var (value, label) in Options.InvestigationStatuses) { <option value="@value" selected="@(Model.Filter?.Status == value)">@label</option> }</select></div>
    <div><label class="usa-label" for="inv-type">Type</label><select class="usa-select" id="inv-type" name="type"><option value="">Any</option>@foreach (var type in new[] { "residential", "workplace", "childCareSchool" }) { <option value="@type" selected="@(Model.Filter?.Type == type)">@Options.Humanize(type)</option> }</select></div>
    <button class="usa-button" type="submit">Apply</button>
</form>
<div id="investigation-list">
    <partial name="_InvestigationList" model="Model" />
</div>
