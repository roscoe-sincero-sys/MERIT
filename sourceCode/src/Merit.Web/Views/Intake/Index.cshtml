@model IntakeModel
@{
    ViewData["Title"] = "Intake";
}
<h1>Intake</h1>
@if (Model.Message is not null && Model.DuplicateOf is Guid earlier)
{
    <div class="usa-alert usa-alert--warning usa-alert--slim" role="alert"><div class="usa-alert__body"><p class="usa-alert__text">@Model.Message
        <a class="usa-link" href="@($"#batch-{earlier}")">Show that batch</a>. If the laboratory sent it again on purpose, choose the file again and tick
        <strong>This is a genuine re-send</strong>.</p></div></div>
}
else if (Model.Message is not null)
{
    <div class="usa-alert usa-alert--@(Model.MessageKind) usa-alert--slim" role="@(Model.MessageKind is "error" or "warning" ? "alert" : "status")"><div class="usa-alert__body"><p class="usa-alert__text">@Model.Message</p></div></div>
}
<section class="merit-section" aria-labelledby="upload-heading">
    <h2 id="upload-heading">Upload a file</h2>
    @* Plain words, no protocol shorthand or repository paths (issues #148 and #167). *@
    <p class="merit-meta">Choose who sent the file and its format: a spreadsheet export (comma, tab or pipe separated) or an
        HL7 laboratory result message, version 2.3.1 or 2.5.1. MERIT keeps the original file and processes it in the
        background: each row is checked, matched to a person, then loaded or held for review. A message in a layout MERIT
        cannot read pauses the batch with the reason. <a class="usa-link" href="/help/guides/operations-guide.html" target="_blank" rel="noopener">How importing works<span class="usa-sr-only"> (opens in a new tab)</span></a></p>
    <form class="usa-form merit-form--wide" method="post" action="/intake/upload" enctype="multipart/form-data" data-upload-busy>
        @Html.AntiForgeryToken()
        <div class="usa-form-group"><label class="usa-label" for="intakeProfileId">Sender and intake profile</label>
            <select class="usa-select merit-select--wide" id="intakeProfileId" name="intakeProfileId">
                @foreach (var p in Model.Profiles) { <option value="@p.IntakeProfileId">@Options.IntakeProfile(p.SenderName, p.ProfileName, p.FileType)</option> }
            </select></div>
        <div class="usa-form-group"><label class="usa-label" for="file">File</label><input class="usa-file-input" id="file" name="file" type="file" accept=".csv,.txt,.tsv,.hl7" required /></div>
        @if (Model.DuplicateOf is not null)
        {
            <div class="usa-checkbox">
                <input class="usa-checkbox__input" id="uploadAgain" name="uploadAgain" type="checkbox" value="true" />
                <label class="usa-checkbox__label" for="uploadAgain">This is a genuine re-send: process it again</label>
            </div>
        }
        <button class="usa-button" type="submit">Upload</button>
    </form>
</section>
<section class="merit-section" aria-labelledby="batches-heading">
    <h2 id="batches-heading">Recent batches</h2>
    <partial name="_Batches" model="Model" />
</section>
