@model UserFormModel
@{
    ViewData["Title"] = Model.AppUserId is null ? "Add a user" : Model.DisplayName;
    string Access(string level) => level switch { "full" => "full", "write" => "read and write, no delete", _ => "read only" };
}
<p><a class="usa-link" href="/admin/users">Back to users</a></p>
<h1>@(Model.AppUserId is null ? "Add a user" : Model.DisplayName)</h1>
@if (!ViewData.ModelState.IsValid)
{
    <partial name="_ErrorSummary" model='new ErrorSummaryModel(["UserName", "DisplayName", "Email", "HomeTenantId", "NewPassword", "IsActive", "FirstRoleId", "FirstTenantId", "FirstAccessLevel", "roleId", "tenantId", "accessLevel", "includeDescendants"], new Dictionary<string, string> { ["UserName"] = "UserName", ["DisplayName"] = "DisplayName", ["Email"] = "Email", ["HomeTenantId"] = "HomeTenantId", ["NewPassword"] = "NewPassword", ["IsActive"] = "IsActive", ["FirstRoleId"] = "FirstRoleId", ["FirstTenantId"] = "FirstTenantId", ["FirstAccessLevel"] = "FirstAccessLevel", ["roleId"] = "roleId", ["tenantId"] = "tenantId", ["accessLevel"] = "accessLevel", ["includeDescendants"] = "includeDescendants" }, SummaryId: "admin-edituser-errors")' />
}
@if (TempData["userError"] is string err)
{
    <div class="usa-alert usa-alert--error usa-alert--slim" role="alert"><div class="usa-alert__body"><p class="usa-alert__text">@err</p></div></div>
}
@if (TempData["userMessage"] is string message)
{
    <div class="usa-alert usa-alert--success usa-alert--slim" role="status"><div class="usa-alert__body"><p class="usa-alert__text">@message</p></div></div>
}
<div class="merit-grid-2">
    @if (Model.CanManageAccount)
    {
        <form class="usa-form" method="post" action="/admin/users">
            @Html.AntiForgeryToken()
            <input type="hidden" name="AppUserId" value="@Model.AppUserId" />
            <div class="usa-form-group"><label class="usa-label" for="UserName">User name</label><input class="usa-input" id="UserName" name="UserName" value="@Model.UserName" readonly="@(Model.AppUserId is not null)" required /></div>
            <div class="usa-form-group"><label class="usa-label" for="DisplayName">Display name</label><input class="usa-input" id="DisplayName" name="DisplayName" value="@Model.DisplayName" required /></div>
            <div class="usa-form-group"><label class="usa-label" for="Email">Work email</label><input class="usa-input" id="Email" name="Email" type="email" value="@Model.Email" /></div>
            <div class="usa-form-group"><label class="usa-label" for="HomeTenantId">Works for</label>
                <div class="usa-hint" id="home-hint">Administrators of this tenant manage the account. You can choose only tenants you administer.</div>
                <select class="usa-select" id="HomeTenantId" name="HomeTenantId" aria-describedby="home-hint">
                    @foreach (var t in Model.Tenants) { <option value="@t.Value" selected="@(t.Value == Model.HomeTenantId?.ToString())">@t.Label</option> }
                </select></div>
            <div class="usa-form-group">
                <label class="usa-label" for="NewPassword">@(Model.AppUserId is null ? "Initial password" : "New password (leave blank to keep)")</label>
                <div class="usa-hint"><partial name="_PasswordRules" model="Model.PasswordMinLength" /></div>
                <input class="usa-input" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" />
                @if (Model.PasswordChangedUtc is DateTime changed)
                {
                    <div class="usa-hint">Password last changed @Options.Date(changed).</div>
                }
            </div>
            @* So the administrator never knows the password the person keeps (#190). *@
            <div class="usa-checkbox"><input class="usa-checkbox__input" id="RequirePasswordChange" type="checkbox" name="RequirePasswordChange" value="true" checked="@(Model.RequirePasswordChange)" aria-describedby="require-change-hint" /><label class="usa-checkbox__label" for="RequirePasswordChange">Ask them to choose a new password at their next sign-in</label></div>
            <div class="usa-hint" id="require-change-hint">Use this when you set a password for someone. After their password and second factor, MERIT asks for a new password before anything else.</div>
            <input type="hidden" name="RequirePasswordChange" value="false" />
            <div class="usa-checkbox"><input class="usa-checkbox__input" id="IsActive" type="checkbox" name="IsActive" value="true" checked="@(Model.IsActive)" /><label class="usa-checkbox__label" for="IsActive">Active (clear to deactivate; the account and its history are kept)</label></div>
            <input type="hidden" name="IsActive" value="false" />
            @if (Model.AppUserId is null)
            {
                @* A new account can be ready to work in one save (issue #163). *@
                <fieldset class="usa-fieldset margin-top-3">
                    <legend class="usa-legend usa-legend--large">First access</legend>
                    <div class="usa-hint" id="first-access-hint">Optional. Without access the person can sign in but sees nothing; you can also give access after saving.</div>
                    <div class="usa-form-group"><label class="usa-label" for="FirstRoleId">Role</label>
                        <select class="usa-select" id="FirstRoleId" name="FirstRoleId" aria-describedby="first-access-hint">
                            <option value="">No access yet</option>
                            @foreach (var r in Model.Roles) { <option value="@r.Value" selected="@(r.Value == Model.FirstRoleId?.ToString())">@r.Label</option> }
                        </select></div>
                    <div class="usa-form-group"><label class="usa-label" for="FirstTenantId">At</label>
                        <select class="usa-select" id="FirstTenantId" name="FirstTenantId">@foreach (var t in Model.Tenants) { <option value="@t.Value" selected="@(t.Value == (Model.FirstTenantId ?? Model.HomeTenantId)?.ToString())">@t.Label</option> }</select></div>
                    <div class="usa-form-group"><label class="usa-label" for="FirstAccessLevel">Access</label>
                        <select class="usa-select" id="FirstAccessLevel" name="FirstAccessLevel">
                            <option value="full" selected="@(Model.FirstAccessLevel == "full")">Full (read, write and delete)</option>
                            <option value="write" selected="@(Model.FirstAccessLevel == "write")">Read and write (no delete)</option>
                            <option value="read" selected="@(Model.FirstAccessLevel == "read")">Read only</option>
                        </select></div>
                    <div class="usa-checkbox"><input class="usa-checkbox__input" id="FirstIncludeDescendants" type="checkbox" name="FirstIncludeDescendants" value="true" checked="@Model.FirstIncludeDescendants" /><label class="usa-checkbox__label" for="FirstIncludeDescendants">Include everything under it</label></div>
                    <input type="hidden" name="FirstIncludeDescendants" value="false" />
                </fieldset>
            }
            <button class="usa-button" type="submit">Save</button>
        </form>
    }
    else
    {
        <div class="usa-summary-box"><div class="usa-summary-box__body">
            <p class="usa-summary-box__text"><strong>@Model.DisplayName</strong> (@Model.UserName) works for <strong>@Model.HomeTenantName</strong>. Their administrators manage the account itself. You can give or end access only at the tenants you administer.</p>
        </div></div>
    }

    @if (Model.AppUserId is Guid id)
    {
        <div>
            <h2>Master profile</h2>
            <p class="merit-meta">Everything this person may do. They can make smaller profiles from it for daily work, never bigger ones, and they cannot change this list themselves.</p>
            @if (Model.Assignments.Count == 0)
            {
                <div class="usa-alert usa-alert--warning usa-alert--slim"><div class="usa-alert__body"><p class="usa-alert__text">No access yet: the person can sign in but sees nothing. Give access below.</p></div></div>
            }
            <ul class="usa-list">
                @foreach (var a in Model.Assignments)
                {
                    <li>@a.RoleName at @a.TenantName @(a.IncludeDescendants ? "and everything under it" : "only") &middot; @Access(a.AccessLevel)
                        <span class="merit-meta">@Options.Date(a.StartDate) &ndash; @(a.EndDate is null ? "current" : Options.Date(a.EndDate))</span>
                        @if (a.EndDate is null && a.CanManage)
                        {
                            <form class="display-inline" method="post" action="/admin/users/@id/assignments/@a.UserAssignmentId/end" data-confirm="End @a.RoleName at @a.TenantName for @Model.DisplayName? All their active sessions will be signed out.">@Html.AntiForgeryToken()<button class="usa-button usa-button--unstyled" type="submit">End<span class="usa-sr-only"> @a.RoleName at @a.TenantName</span></button></form>
                        }
                        else if (!a.CanManage) { <span class="merit-meta">(managed by another administrator)</span> }
                    </li>
                }
            </ul>
            <h3 id="give-access" tabindex="-1">Give access</h3>
            <form class="usa-form" method="post" action="/admin/users/@id/assignments" aria-labelledby="give-access">
                @Html.AntiForgeryToken()
                <div class="usa-form-group"><label class="usa-label" for="roleId">Role</label>
                    <select class="usa-select" id="roleId" name="roleId">@foreach (var r in Model.Roles) { <option value="@r.Value">@r.Label</option> }</select></div>
                <div class="usa-form-group"><label class="usa-label" for="tenantId">At</label>
                    <select class="usa-select" id="tenantId" name="tenantId">@foreach (var t in Model.Tenants) { <option value="@t.Value">@t.Label</option> }</select></div>
                <div class="usa-form-group"><label class="usa-label" for="accessLevel">Access</label>
                    <select class="usa-select" id="accessLevel" name="accessLevel">
                        <option value="full">Full (read, write and delete)</option>
                        <option value="write">Read and write (no delete)</option>
                        <option value="read">Read only</option>
                    </select></div>
                <div class="usa-checkbox"><input class="usa-checkbox__input" id="includeDescendants" type="checkbox" name="includeDescendants" value="true" checked /><label class="usa-checkbox__label" for="includeDescendants">Include everything under it</label></div>
                <input type="hidden" name="includeDescendants" value="false" />
                <button class="usa-button usa-button--outline" type="submit">Add grant</button>
                <p class="merit-meta">You can grant only at tenants you administer, and never more than you can do there yourself. A change signs the person out of open sessions.</p>
            </form>

            @if (Model.CanViewAs)
            {
                <h2>Check what they see</h2>
                <form method="post" action="/account/view-as/@id">@Html.AntiForgeryToken()
                    <button class="usa-button usa-button--outline" type="submit">View MERIT as @Model.DisplayName</button></form>
                <p class="merit-meta">Limited to what you manage. Return from the banner at the top of every page.</p>
            }

            @if (Model.CanManageAccount)
            {
                <h2>Multi-factor authentication</h2>
                <p>@(Model.MfaEnabled ? "Enrolled." : "Not yet enrolled; the person enrolls at next sign-in.")</p>
                @if (Model.LockoutEndUtc > DateTime.UtcNow)
                {
                    <p>Account locked until @Model.LockoutEndUtc.Value.ToString("u").</p>
                    <form method="post" action="/admin/users/@id/unlock">@Html.AntiForgeryToken()
                        <button class="usa-button usa-button--outline" type="submit">Unlock account</button></form>
                }
                @if (Model.MfaEnabled)
                {
                <form method="post" action="/admin/users/@id/reset-mfa" data-confirm="Reset MFA for @Model.DisplayName? Their authenticator and recovery codes will stop working, and active sessions will be signed out. Verify the person before continuing.">
                    @Html.AntiForgeryToken()
                    <button class="usa-button usa-button--secondary" type="submit">Reset MFA after verifying the person</button>
                </form>
                }

                <partial name="_SignInHistory" model="Model.SignInHistory" />
                <p><a class="usa-link" href="/admin/users/@Model.AppUserId/sign-in-history.csv" download>Export this account's sign-in history (CSV)</a></p>
            }
        </div>
    }
</div>
