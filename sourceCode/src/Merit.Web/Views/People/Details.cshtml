@model PersonPageModel
@{
    ViewData["Title"] = Model.FullName;
}
<partial name="_Breadcrumbs" model='(IReadOnlyList<BreadcrumbItem>)[new("People", "/search"), new("Patient")]' />
<partial name="_Header" model="Model" />
<p><a class="usa-button usa-button--outline" href="/people/@Model.Person.PersonId/care">Patient activities, notification deadlines and documents</a></p>
<div class="workspace-context" aria-label="Patient context"><strong>@Model.FullName</strong> | @Model.Person.Dob</div>
<nav class="workspace-sections" aria-label="Patient sections"><a href="#section-results">Lab results</a><a href="#section-cases">Cases and history</a><a href="/people/@Model.Person.PersonId/care#activity">Activity</a><a href="/people/@Model.Person.PersonId/care#documents">Documents</a>@foreach(var item in Model.Sections.Where(s => s.Key != "results" && s.Key != "cases")) { <a href="#section-@item.Key">@item.Title</a> }</nav>
<partial name="_AuditLink" model='(Model.Person.PersonId, "person")' />

@* Sections in the order the person's population gives them; every section stays visible with an empty state. *@
@foreach (var s in Model.Sections)
{
    switch (s.Key)
    {
        case "relationships":
            <partial name="_Relationships" model="Model.Relationships" />
            break;
        case "places":
            <partial name="_Places" model="Model.Places" />
            break;
        case "results":
            <partial name="_Results" model="Model.Results" />
            break;
        case "cases":
            <partial name="_Cases" model="Model.Cases" />
            break;
        case "employment":
            @if(Model.Employment.Rows.Count == 0 && Model.Page.CurrentPopulation == "child") { <details class="merit-details"><summary>Employment (none recorded)</summary><partial name="_Employment" model="Model.Employment" /></details> } else { <partial name="_Employment" model="Model.Employment" /> }
            break;
        case "sources":
            @if(Model.Sources.Rows.Count == 0) { <details class="merit-details"><summary>Exposure sources (none recorded)</summary><partial name="_Sources" model="Model.Sources" /></details> } else { <partial name="_Sources" model="Model.Sources" /> }
            break;
        case "pregnancy":
            <partial name="_Pregnancy" model="Model.Pregnancy" />
            break;
        case "timeline":
            <section class="merit-section" id="section-timeline" aria-labelledby="timeline-heading">
                <h2 id="timeline-heading">Timeline</h2>
                <p>Results, address changes, job changes and case events on one time axis.
                    <a class="usa-link" href="/app/people/@Model.Person.PersonId/timeline">Open the interactive timeline</a>.</p>
            </section>
            break;
    }
}
