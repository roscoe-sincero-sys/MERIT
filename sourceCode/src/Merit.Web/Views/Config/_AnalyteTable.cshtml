@model AnalytesModel
<div class="merit-table-wrap" id="analyte-table-body">
    <table class="usa-table usa-table--borderless">
        <thead><tr><th scope="col">Code</th><th scope="col">Analyte</th><th scope="col">Specimens (canonical unit)</th><th scope="col">Extracts</th><th scope="col">Active and order</th></tr></thead>
        <tbody>
            @foreach (var a in Model.Analytes)
            {
                <tr>
                    <td>@a.Code</td>
                    <td>@a.DisplayName</td>
                    <td>@string.Join("; ", Model.Specimens.Where(s => s.AnalyteId == a.AnalyteId).Select(s => $"{Options.Humanize(s.Specimen)} ({s.CanonicalUnit}){(s.UsesSampleType ? ", sample type" : "")}{(s.RequiresCreatinine ? ", creatinine" : "")}{(string.IsNullOrEmpty(s.SpeciationOptions) ? "" : ", speciation " + s.SpeciationOptions)}"))</td>
                    <td>@a.ExtractTargets</td>
                    <td>
                        @if (Model.CanEdit)
                        {
                            <form class="merit-form-row" hx-post="/config/analytes/@a.AnalyteId" hx-target="#analyte-table" hx-swap="innerHTML">
                                <div class="usa-checkbox"><input class="usa-checkbox__input" id="act-@a.Code" type="checkbox" name="isActive" value="true" checked="@(a.IsActive)" /><label class="usa-checkbox__label" for="act-@a.Code">Active</label></div>
                                <input type="hidden" name="isActive" value="false" />
                                <label class="usa-sr-only" for="ord-@a.Code">Sort order</label><input class="usa-input usa-input--small" id="ord-@a.Code" name="sortOrder" value="@a.SortOrder" />
                                <button class="usa-button usa-button--outline usa-button--small" type="submit">Save</button>
                            </form>
                        }
                        else
                        {
                            @(a.IsActive ? "Active" : "Inactive")
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
