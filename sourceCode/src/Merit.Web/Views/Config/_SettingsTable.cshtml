@model SettingsModel
<div class="merit-table-wrap" id="settings-table-body" tabindex="0" role="region" aria-label="Jurisdiction settings; scroll for more columns">
    <table class="usa-table usa-table--borderless usa-table--compact">
        <thead><tr><th scope="col">Setting</th><th scope="col">Value</th><th scope="col">Since</th><th scope="col">What it decides</th></tr></thead>
        <tbody>
            @foreach (var s in Model.Current)
            {
                <tr id="setting-@s.SettingKey">
                    <th scope="row">@Options.Humanize(s.SettingKey)</th>
                    <td>
                        @if (Model.CanEdit)
                        {
                            <form class="merit-form-row" hx-post="/config/settings/@s.SettingKey" hx-target="#settings-table" hx-swap="innerHTML">
                                <label class="usa-sr-only" for="v-@s.SettingKey">Value of @s.SettingKey</label>
                                @if (s.SettingKey == "testingPolicyVersion") {
                                <select class="usa-select" id="v-@s.SettingKey" name="settingValue"><option value="none" selected="@(s.SettingValue == "none")">No testing policy (off)</option><option value="MDH-2025-03" selected="@(s.SettingValue == "MDH-2025-03")">MDH March 2025 (Maryland only)</option></select>
                                } else {
                                <input class="usa-input @(s.SettingValue == "NOTSET" ? "usa-input--error" : "")" id="v-@s.SettingKey" name="settingValue" value="@s.SettingValue" />
                                }
                                <label class="usa-sr-only" for="d-@s.SettingKey">Effective from</label>
                                <input class="usa-input" id="d-@s.SettingKey" name="effectiveFrom" type="date" value="@Options.Iso(Clock.Today)" />
                                <button class="usa-button usa-button--outline usa-button--small" type="submit">Change</button>
                                @if (s.SettingKey == Merit.Application.Services.ConfigService.EmailCodesSetting)
                                {
                                    @* Before email codes can be turned on, NIST's position is stated and confirmed (specification, Authentication). *@
                                    <div class="usa-checkbox merit-setting-ack">
                                        <input class="usa-checkbox__input" id="ack-@s.SettingKey" type="checkbox" name="acknowledgeEmailCodeRisk" value="true" />
                                        <label class="usa-checkbox__label" for="ack-@s.SettingKey">I understand that NIST SP 800-63B-4 does not accept email for out-of-band authentication. Email codes stay an extra option: everyone keeps the authenticator app, and administrators never get email codes.</label>
                                    </div>
                                }
                            </form>
                        }
                        else
                        {
                            @s.SettingValue
                        }
                    </td>
                    <td>@Options.Date(s.EffectiveFrom)<div class="merit-meta">@s.ModifiedBy</div></td>
                    <td class="merit-meta">@s.SettingDescription</td>
                </tr>
            }
        </tbody>
    </table>
    <details>
        <summary>History (@Model.History.Count rows)</summary>
        <ul class="usa-list">
            @foreach (var h in Model.History.OrderBy(h => h.SettingKey).ThenByDescending(h => h.EffectiveFrom))
            {
                <li>@h.SettingKey = @h.SettingValue, @Options.Date(h.EffectiveFrom) &ndash; @(h.EffectiveTo is null ? "current" : Options.Date(h.EffectiveTo)) <span class="merit-meta">@h.ModifiedBy</span></li>
            }
        </ul>
    </details>
</div>
