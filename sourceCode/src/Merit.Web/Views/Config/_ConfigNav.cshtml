@model string
@inject ICurrentSession Session
<nav class="merit-config-nav" aria-label="Configuration">
    <ul class="usa-button-group usa-button-group--segmented">
        <li class="usa-button-group__item"><a class="usa-button @(Model == "thresholds" ? "" : "usa-button--outline")" aria-current="@(Model == "thresholds" ? "page" : null)" href="/config/thresholds">Thresholds</a></li>
        <li class="usa-button-group__item"><a class="usa-button @(Model == "settings" ? "" : "usa-button--outline")" aria-current="@(Model == "settings" ? "page" : null)" href="/config/settings">Jurisdiction settings</a></li>
        <li class="usa-button-group__item"><a class="usa-button @(Model == "analytes" ? "" : "usa-button--outline")" aria-current="@(Model == "analytes" ? "page" : null)" href="/config/analytes">Analytes</a></li>
        @if(Session.Has(Permissions.ConfigEdit)) { <li class="usa-button-group__item"><a class="usa-button @(Model == "notifications" ? "" : "usa-button--outline")" aria-current="@(Model == "notifications" ? "page" : null)" href="/config/notification-rules">Notification rules</a></li> }
        @if(Session.Has(Permissions.ConfigEdit)) { <li class="usa-button-group__item"><a class="usa-button @(Model == "workflows" ? "" : "usa-button--outline")" aria-current="@(Model == "workflows" ? "page" : null)" href="/config/workflows">Program tasks</a></li> }
    </ul>
</nav>
