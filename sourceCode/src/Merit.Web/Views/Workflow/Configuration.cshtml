@model WorkflowConfigurationModel
@{ ViewData["Title"] = "Program tasks"; var d=Model.Draft;
string V(string key,string fallback="") => ViewData.ModelState.TryGetValue(key,out var e) ? e.AttemptedValue ?? fallback : fallback;
string B(bool value) => value ? "true" : "false";
var current=Model.Definitions.FirstOrDefault(r=>r.WorkflowDefinitionId==d.WorkflowDefinitionId);
var fields=System.Text.Json.JsonSerializer.Deserialize<EvidenceField[]>(d.EvidenceFieldsJson,new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)) ?? [];
var holidays=System.Text.Json.JsonSerializer.Deserialize<string[]>(d.HolidayDatesJson) ?? [];
}
<partial name="~/Views/Config/_ConfigNav.cshtml" model='@("workflows")' />
<h1>Program tasks and activity requirements</h1>
<p>Draft, preview and publish an approved agency policy. New versions do not rewrite existing task instructions, evidence or deadlines. No jurisdiction example is activated automatically. <a href="/config/workflows">New draft</a> · <a href="/config/workflows?template=outreach">Review a three-attempt outreach draft</a></p>
@if(TempData["WorkMessage"] is string message) { <div class="usa-alert usa-alert--success" role="status"><p>@message</p></div> }
@if(!ViewData.ModelState.IsValid) { <div class="usa-alert usa-alert--error" role="alert"><h2>Policy was not saved</h2><div asp-validation-summary="All"></div></div> }
<h2>Definition history</h2>
@if(Model.Definitions.Count==0) { <p>No definitions. Create a draft and obtain program approval before publishing.</p> }
@foreach(var r in Model.Definitions) {
<article class="merit-section"><h3><a href="/config/workflows?id=@r.WorkflowDefinitionId">@r.Name · version @r.Version</a> — @r.DefinitionStatus</h3><p>@r.ScopeName · @r.TriggerEvent · @r.EffectiveFrom to @(r.EffectiveTo?.ToString() ?? "no end date")</p><p>@r.Description</p>
<p>Approval: @(r.ApprovalReference ?? "Not published") · Suggested role: @(r.AssignmentRoleCode ?? "Team assignment")</p>
@if(r.DefinitionStatus=="published") { <form asp-antiforgery="true" method="post" action="/config/workflows/@r.WorkflowDefinitionId/evaluate"><button class="usa-button usa-button--outline">Evaluate existing patients</button></form><form asp-antiforgery="true" method="post" action="/config/workflows/@r.WorkflowDefinitionId/retire"><button class="usa-button usa-button--outline">Retire future generation</button></form> }
<a href="/config/workflows?id=@r.WorkflowDefinitionId&amp;copy=true">Copy as a new version</a></article>
}
@if(current is null || current.DefinitionStatus=="draft") {
<h2>Draft definition</h2>
<form asp-antiforgery="true" method="post" action="/config/workflows/draft" class="usa-form usa-form--large" id="workflow-definition-form" data-unsaved-work>
<input type="hidden" name="WorkflowDefinitionId" value="@d.WorkflowDefinitionId" /><input type="hidden" name="VersionStamp" value="@d.VersionStamp" />
<label class="usa-label" for="Name">Task / activity name</label><input class="usa-input" name="Name" id="Name" required maxlength="120" value="@V("Name",d.Name)" />
<label class="usa-label" for="Version">Version number</label><input class="usa-input" name="Version" id="Version" type="number" min="1" required value="@V("Version",d.Version.ToString())" />
<label class="usa-label" for="Description">Instructions and conditional facts staff must verify</label><textarea class="usa-textarea" name="Description" id="Description" required maxlength="1000">@V("Description",d.Description)</textarea>
<label class="usa-label" for="TriggerEvent">Create this task when</label><select class="usa-select" name="TriggerEvent" id="TriggerEvent">@foreach(var o in new[] {("patientReview","A patient is evaluated"),("receivedResult","A final/corrected lab result is received"),("caseOpened","An active case is evaluated (once per case)")}) { <option value="@o.Item1" selected="@(V("TriggerEvent",d.TriggerEvent)==o.Item1)">@o.Item2</option> }</select>
<p>New received results are evaluated automatically. For existing patients, use the explicit evaluation action after publication. A patient-review definition creates patient-only work; case definitions retain case context.</p>
<label class="usa-label" for="Population">Patient group</label><select class="usa-select" name="Population" id="Population">@foreach(var p in new[]{"all","child","adult","pregnant"}) { <option value="@p" selected="@(V("Population",d.Population)==p)">@Options.Humanize(p)</option> }</select>
<label class="usa-label" for="AnalyteSpecimenId">Substance, sample and comparison unit (optional)</label><select class="usa-select" name="AnalyteSpecimenId" id="AnalyteSpecimenId"><option value="">Any substance; no numeric threshold</option>@foreach(var s in Model.Specimens) { <option value="@s.Value" selected="@(V("AnalyteSpecimenId",d.AnalyteSpecimenId?.ToString() ?? "")==s.Value)">@s.Label</option> }</select>
<div class="merit-form-row"><div><label class="usa-label" for="MinimumValue">Result minimum, inclusive (optional)</label><input class="usa-input" type="number" step="0.000001" min="0" name="MinimumValue" id="MinimumValue" value="@V("MinimumValue",d.MinimumValue?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" /></div><div><label class="usa-label" for="MaximumValue">Result maximum, exclusive (optional)</label><input class="usa-input" type="number" step="0.000001" min="0" name="MaximumValue" id="MaximumValue" value="@V("MaximumValue",d.MaximumValue?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" /></div></div>
<div class="merit-form-row"><div><label class="usa-label" for="MinimumAgeMonths">Minimum age in months (optional)</label><input class="usa-input" type="number" min="0" name="MinimumAgeMonths" id="MinimumAgeMonths" value="@V("MinimumAgeMonths",d.MinimumAgeMonths?.ToString() ?? "")" /></div><div><label class="usa-label" for="MaximumAgeMonths">Maximum age in months (optional)</label><input class="usa-input" type="number" min="0" name="MaximumAgeMonths" id="MaximumAgeMonths" value="@V("MaximumAgeMonths",d.MaximumAgeMonths?.ToString() ?? "")" /></div></div>
<label class="usa-label" for="RequiresEligibilityReview">Additional source-based eligibility review</label><select class="usa-select" name="RequiresEligibilityReview" id="RequiresEligibilityReview"><option value="false" selected="@(!d.RequiresEligibilityReview)">No additional conditions beyond the fields above</option><option value="true" selected="@d.RequiresEligibilityReview">Require staff to verify the conditional facts in the instructions</option></select>
<label class="usa-label" for="CompletionKind">Evidence needed to complete</label><select class="usa-select" name="CompletionKind" id="CompletionKind">@foreach(var o in new[]{("internal","Internal work: completed outcome and note"),("contact","Successful external contact: recipient, channel and reached outcome"),("delivery","Completed external delivery: recipient, channel and completed outcome")}) { <option value="@o.Item1" selected="@(V("CompletionKind",d.CompletionKind)==o.Item1)">@o.Item2</option> }</select>
<label class="usa-label" for="evidenceFields">Additional evidence fields (one per line)</label><textarea class="usa-textarea" name="evidenceFields" id="evidenceFields" maxlength="4000" aria-describedby="fields-help">@V("evidenceFields",string.Join("\n",fields.Select(f=>$"{f.Key} | {f.Label} | {f.Type} | {B(f.Required)}")))</textarea><p id="fields-help">Up to ten fields. Format: short ID | visible label | text/date/number/yesNo | true/false (required). Example: <code>documentRef | Document reference | text | true</code>. These become labelled controls for staff.</p>
<label class="usa-label" for="AssignmentRoleCode">Suggested responsible role (optional)</label><input class="usa-input" name="AssignmentRoleCode" id="AssignmentRoleCode" value="@V("AssignmentRoleCode",d.AssignmentRoleCode ?? "")" maxlength="40" /><p>Use an existing role code, such as caseManager or investigator. This is a team assignment suggestion; it does not grant permissions or assign an arbitrary worker.</p>
<div class="merit-form-row"><div><label class="usa-label" for="DueInDays">Days after source event (optional)</label><input class="usa-input" type="number" min="0" max="365" name="DueInDays" id="DueInDays" value="@V("DueInDays",d.DueInDays?.ToString() ?? "")" /></div><div><label class="usa-label" for="RecurrenceDays">Repeat after actual completion, in days (optional)</label><input class="usa-input" type="number" min="1" max="365" name="RecurrenceDays" id="RecurrenceDays" value="@V("RecurrenceDays",d.RecurrenceDays?.ToString() ?? "")" /></div></div>
<p>Blank due interval creates no invented deadline. Zero means the source date. Recurrence creates one new occurrence from actual completion, preserving the old one. Required recurring work needs an explicit stop/waiver/transfer decision before closure.</p>
<label class="usa-label" for="DayBasis">Day calculation</label><select class="usa-select" name="DayBasis" id="DayBasis"><option value="calendar" selected="@(d.DayBasis=="calendar")">Calendar days</option><option value="business" selected="@(d.DayBasis=="business")">Business days (weekends and listed holidays excluded)</option></select>
<label class="usa-label" for="TimeZoneId">Policy time zone</label><input class="usa-input" name="TimeZoneId" id="TimeZoneId" required value="@V("TimeZoneId",d.TimeZoneId)" maxlength="100" />
<label class="usa-label" for="holidayDates">Approved holiday dates (YYYY-MM-DD, one per line)</label><textarea class="usa-textarea" name="holidayDates" id="holidayDates">@V("holidayDates",string.Join("\n",holidays))</textarea><p>For business days, blank means weekends only. Approve that choice explicitly.</p>
<label class="usa-label" for="BlocksClosure">Closure requirement</label><select class="usa-select" name="BlocksClosure" id="BlocksClosure"><option value="false" selected="@(!d.BlocksClosure)">Routine work; review automatic dismissal at closure</option><option value="true" selected="@d.BlocksClosure">Require completion, justified applicability, authorized waiver or transfer</option></select>
<label class="usa-label" for="ClosureReason">Closure reason this requirement governs</label><select class="usa-select" name="ClosureReason" id="ClosureReason">@foreach(var reason in new[]{"all","lostToFollowUp","belowLevelOnRetest","movedOutOfState","declined","deceased","duplicate","other"}) { <option value="@reason" selected="@(V("ClosureReason",d.ClosureReason)==reason)">@Options.Humanize(reason)</option> }</select>
<label class="usa-label" for="MinimumContactAttempts">Minimum recorded unsuccessful contact attempts</label><input class="usa-input" type="number" min="0" max="20" name="MinimumContactAttempts" id="MinimumContactAttempts" value="@V("MinimumContactAttempts",d.MinimumContactAttempts.ToString())" /><p>Counts non-withdrawn attempts with an identified recipient and no-answer, left-message or wrong-number outcome. Set zero when no such requirement applies. Completion of a task never invents those attempts.</p>
<label class="usa-label" for="AllowWaiver">Authorized exceptions</label><select class="usa-select" name="AllowWaiver" id="AllowWaiver"><option value="false" selected="@(!d.AllowWaiver)">No waiver</option><option value="true" selected="@d.AllowWaiver">Allow a documented exception by a profile with workflow waiver permission</option></select>
<div class="merit-form-row"><div><label class="usa-label" for="EffectiveFrom">Source events from</label><input class="usa-input" type="date" name="EffectiveFrom" id="EffectiveFrom" required value="@V("EffectiveFrom",d.EffectiveFrom.ToString("yyyy-MM-dd"))" /></div><div><label class="usa-label" for="EffectiveTo">Source events through (optional)</label><input class="usa-input" type="date" name="EffectiveTo" id="EffectiveTo" value="@V("EffectiveTo",d.EffectiveTo?.ToString("yyyy-MM-dd") ?? "")" /></div></div>
<button class="usa-button">Save draft for preview</button></form>
}
@if(current is not null) {
<section class="merit-section"><h2>Preview two sample patients</h2><p>Use IDs from accessible synthetic/test patient records when validating a new policy. For case-triggered policies include the corresponding active case IDs. Preview shows why each source matches, needs review, or is outside the policy.</p>
<form asp-antiforgery="true" method="post" action="/config/workflows/@d.WorkflowDefinitionId/preview" class="usa-form">
<label class="usa-label" for="samplePersonId">First sample patient ID</label><input class="usa-input" id="samplePersonId" name="samplePersonId" required value="@Model.SamplePersonId" />
<label class="usa-label" for="sampleCaseId">First sample active case ID (when applicable)</label><input class="usa-input" id="sampleCaseId" name="sampleCaseId" value="@Model.SampleCaseId" />
<label class="usa-label" for="secondSamplePersonId">Second sample patient ID</label><input class="usa-input" id="secondSamplePersonId" name="secondSamplePersonId" required value="@Model.SecondSamplePersonId" />
<label class="usa-label" for="secondSampleCaseId">Second sample active case ID (when applicable)</label><input class="usa-input" id="secondSampleCaseId" name="secondSampleCaseId" value="@Model.SecondSampleCaseId" />
<button class="usa-button usa-button--outline">Preview eligibility</button></form>
@foreach(var p in Model.Previews) { <article><h3>Sample @p.PersonId — @Options.Humanize(p.EvaluationState)</h3><p>@p.Explanation Source date: @p.AnchorDate</p></article> }
@if(current.DefinitionStatus=="draft" && Model.Previews.Count==2) {
<h3>Publish this previewed version</h3><form asp-antiforgery="true" method="post" action="/config/workflows/@d.WorkflowDefinitionId/publish" class="usa-form">
<input type="hidden" name="versionStamp" value="@d.VersionStamp" /><input type="hidden" name="samplePersonId" value="@Model.SamplePersonId" /><input type="hidden" name="secondSamplePersonId" value="@Model.SecondSamplePersonId" /><input type="hidden" name="sampleCaseId" value="@Model.SampleCaseId" /><input type="hidden" name="secondSampleCaseId" value="@Model.SecondSampleCaseId" />
<label class="usa-label" for="approvalReference">Program-owner approval reference</label><input class="usa-input" id="approvalReference" name="approvalReference" required maxlength="300" />
<div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" id="approved" name="approved" value="true" required /><label class="usa-checkbox__label" for="approved">The program owner approved the previewed eligibility, evidence, recurrence, role, closure criteria and calendar, including any choice to exclude no holidays.</label></div><button class="usa-button">Publish approved version</button></form>
}</section>
}
