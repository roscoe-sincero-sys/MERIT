@model TaskEvidenceModel
@inject ICurrentSession Session
@{ ViewData["Title"]="Task evidence"; var t=Model.Task; var p=Model.Person.Header.Person;
string V(string k,string fallback="") => ViewData.ModelState.TryGetValue(k,out var e) ? e.AttemptedValue ?? fallback : fallback; }
<p><a href="/people/@p.PersonId/work">Patient work checklist and history</a> @if(t.ExposureCaseId is not null) { <a href="/cases/@t.ExposureCaseId">Back to case @t.CaseNumber</a> }</p>
<h1>@t.Title</h1><div class="workspace-context"><strong>@p.LastName, @p.FirstName</strong> · @(t.CaseNumber ?? "Patient only")</div>
@if(TempData["WorkMessage"] is string message) { <div class="usa-alert usa-alert--success" role="status"><p>@message</p></div> }
@if(!ViewData.ModelState.IsValid) { <div class="usa-alert usa-alert--error" role="alert"><h2>Outcome was not saved</h2><div asp-validation-summary="All"></div></div> }
<p class="care-note">@t.Detail</p><p>Status: @Options.Humanize(t.TaskStatus). Disposition: @(t.ResolutionKind ?? "Pending / not recorded"). Due @(t.DueDate?.ToString("yyyy-MM-dd") ?? "no numeric deadline").</p><p class="care-note">@t.ResolutionNote</p>
<p>Required completion: @t.CompletionKind. Unsuccessful contact is recorded as an attempt and leaves the task open. Saving once records both the task outcome and one patient/case activity.</p>
@if(t.WorkflowSnapshotJson is not null) { <details><summary>Original approved task version and evidence requirements</summary><pre class="care-policy">@t.WorkflowSnapshotJson</pre></details> }
@if(t.TaskStatus=="open" && Session.Has(Permissions.PersonEdit) && Session.Has(Permissions.TaskEdit) && (t.ExposureCaseId is null || Session.Has(Permissions.CaseEdit))) {
<form asp-antiforgery="true" method="post" action="/work/tasks/@t.WorkTaskId" class="usa-form" id="task-evidence-form" data-unsaved-work>
<input type="hidden" name="personActivityId" value="@V("personActivityId",Guid.NewGuid().ToString())" />
<label class="usa-label" for="action">What happened?</label><select class="usa-select" id="action" name="action">
@if(t.EvaluationState=="needsReview") { <option value="apply">Verified: this conditional task applies</option><option value="exclude">Verified: this task does not apply (explain why)</option> }
else { <option value="complete">Work actually completed</option><option value="attempt">Contact attempted; leave required work open</option> }
@if(Session.Has(Permissions.WorkflowWaive) && string.Equals(t.Snapshot("allowWaiver"),"True",StringComparison.OrdinalIgnoreCase)) { <option value="waive">Authorize a policy-permitted exception (explain why)</option> }
@if(Session.Has(Permissions.CaseEdit)) { <option value="transfer">Transfer outstanding work to another active case</option> }
</select>
<label class="usa-label" for="activityDate">Actual event date</label><input class="usa-input" type="date" id="activityDate" name="activityDate" required value="@V("activityDate",Clock.Today.ToString("yyyy-MM-dd"))" />
<label class="usa-label" for="audience">Audience</label><select class="usa-select" id="audience" name="audience">@foreach(var a in new[]{"internal","patient","caregiver","provider","owner"}) { <option value="@a" selected="@(V("audience",t.CompletionKind=="internal" ? "internal":"patient")==a)">@Options.Humanize(a)</option> }</select>
<label class="usa-label" for="contactPersonId">Patient or recorded contact</label><select class="usa-select" id="contactPersonId" name="contactPersonId"><option value="">No recorded contact / use external recipient below</option><option value="@p.PersonId" selected="@(V("contactPersonId",t.CompletionKind=="internal" ? "":p.PersonId.ToString())==p.PersonId.ToString())">Patient: @p.FirstName @p.LastName</option>@foreach(var r in Model.Person.Relationships) { <option value="@r.OtherPersonId" selected="@(V("contactPersonId")==r.OtherPersonId.ToString())">@r.OtherFirstName @r.OtherLastName · @r.Role</option> }</select>
<label class="usa-label" for="recipientLabel">Other external recipient / source reference</label><input class="usa-input" id="recipientLabel" name="recipientLabel" maxlength="200" value="@V("recipientLabel")" />
<label class="usa-label" for="channel">Contact channel</label><select class="usa-select" id="channel" name="channel">@foreach(var a in new[]{"internal","phone","email","letter","inPerson","portal","other"}) { <option value="@a" selected="@(V("channel",t.CompletionKind=="internal" ? "internal":"phone")==a)">@Options.Humanize(a)</option> }</select>
<label class="usa-label" for="outcome">Actual outcome</label><select class="usa-select" id="outcome" name="outcome">@foreach(var a in new[]{"completed","reached","noAnswer","leftMessage","wrongNumber"}) { <option value="@a" selected="@(V("outcome",t.CompletionKind=="contact" ? "reached":"completed")==a)">@Options.Humanize(a)</option> }</select>
@foreach(var f in t.EvidenceFields) {
<label class="usa-label" for="evidence_@f.Key">@f.Label @(f.Required ? "(required for completion)":"(optional)")</label>
@if(f.Type=="yesNo") { <select class="usa-select" id="evidence_@f.Key" name="evidence_@f.Key"><option value="">Choose</option><option value="yes" selected="@(V("evidence_"+f.Key)=="yes")">Yes</option><option value="no" selected="@(V("evidence_"+f.Key)=="no")">No</option></select> }
else { <input class="usa-input" id="evidence_@f.Key" name="evidence_@f.Key" type="@(f.Type=="date" ? "date":f.Type=="number" ? "number":"text")" step="@(f.Type=="number" ? "any":null)" maxlength="200" value="@V("evidence_"+f.Key)" /> }
}
<label class="usa-label" for="note">What happened? Include evidence or the exception/applicability reason.</label><textarea class="usa-textarea" id="note" name="note" required maxlength="1000">@V("note")</textarea>
<label class="usa-label" for="transferCaseId">Receiving active case (transfer only)</label><select class="usa-select" id="transferCaseId" name="transferCaseId"><option value="">No transfer</option>@foreach(var c in Model.Person.Cases.Where(c=>c.CaseStatus!="closed" && c.ExposureCaseId!=t.ExposureCaseId)) { <option value="@c.ExposureCaseId">@c.CaseNumber · @c.AnalyteName</option> }</select>
<div class="usa-checkbox"><input class="usa-checkbox__input" type="checkbox" id="confirmed" name="confirmed" value="true" required /><label class="usa-checkbox__label" for="confirmed">I verified the patient, task and actual outcome against the recorded source evidence.</label></div><button class="usa-button">Save task outcome and activity</button></form>
}
else if(t.CompletionActivityId is not null) { <p><a href="/people/@p.PersonId/care#activity">Review or correct the original activity; corrections reopen linked work.</a></p> }
